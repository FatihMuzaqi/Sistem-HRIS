@model List<SistemHRD.ViewModels.PenyerahanAsetItemViewModel>
@{
    ViewData["Title"] = "Aset Inventaris Yang Saya Pegang";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i data-lucide="package-check" class="me-2 text-success" style="width:26px;height:26px;display:inline-block;vertical-align:bottom;"></i>
                Aset Inventaris Yang Ditugaskan Kepada Saya
            </h4>
            <p class="text-muted small mb-0">Daftar perangkat kerja, inventaris operasional, dan perlengkapan kantor yang sedang Anda pegang.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
            Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NOMOR & NAMA ASET</th>
                            <th>NOMOR BAST</th>
                            <th>TANGGAL PENYERAHAN</th>
                            <th>KONDISI AWAL</th>
                            <th>KELENGKAPAN</th>
                            <th>STATUS</th>
                            <th>PETUGAS PENYERAH</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@a.NamaAset</div>
                                        <div class="text-muted small"><code>@a.NomorAset</code></div>
                                    </td>
                                    <td>
                                        <code>@a.NomorDokumen</code>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@a.TanggalPenyerahan.ToString("dd MMM yyyy")</div>
                                        @if (a.TanggalTargetPengembalian.HasValue)
                                        {
                                            <div class="text-muted small">Target: @a.TanggalTargetPengembalian.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@a.KondisiSaatPenyerahan</span>
                                    </td>
                                    <td>
                                        <div class="small text-muted" style="max-width:250px;">@(a.KelengkapanAset ?? "-")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">Aktif Digunakan</span>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@a.DiserahkanOleh</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i data-lucide="box" class="d-block mx-auto mb-2 text-muted" style="width:40px;height:40px;"></i>
                                    Saat ini tidak ada aset perusahaan yang ditugaskan kepada Anda.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
