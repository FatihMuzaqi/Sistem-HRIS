@model SistemHRD.ViewModels.DaftarAsetPagedViewModel
@{
    ViewData["Title"] = "Daftar Inventaris Aset Perusahaan";
    var kategoriTerpilih = ViewBag.KategoriTerpilih as SistemHRD.Models.Enums.KategoriAset?;
    var statusTerpilih = ViewBag.StatusTerpilih as SistemHRD.Models.Enums.StatusAset?;
    var kondisiTerpilih = ViewBag.KondisiTerpilih as SistemHRD.Models.Enums.KondisiAset?;
    var kataKunci = ViewBag.KataKunci as string;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i data-lucide="package" class="me-2 text-success" style="width:26px;height:26px;display:inline-block;vertical-align:bottom;"></i>
                Daftar Inventaris Aset Perusahaan
            </h4>
            <p class="text-muted small mb-0">Kelola informasi aset, nomor inventaris, kondisi fisik, dan riwayat pemegang aset karyawan.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Dashboard
            </a>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("HRD"))
            {
                <a asp-action="TambahAset" class="btn btn-success text-white">
                    <i data-lucide="plus" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                    Tambah Aset Baru
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifikasi -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i data-lucide="check-circle" class="me-2 text-success" style="width:20px;height:20px;"></i>
            <div>@TempData["PesanSukses"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i data-lucide="alert-circle" class="me-2 text-danger" style="width:20px;height:20px;"></i>
            <div>@TempData["PesanError"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Pencarian</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i data-lucide="search" style="width:16px;height:16px;" class="text-muted"></i>
                        </span>
                        <input type="text" name="kataKunci" value="@kataKunci" class="form-control border-start-0" placeholder="Nomor aset, nama, merk..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Kategori</label>
                    <select name="kategori" class="form-select">
                        <option value="">Semua Kategori</option>
                        @foreach (SistemHRD.Models.Enums.KategoriAset k in Enum.GetValues(typeof(SistemHRD.Models.Enums.KategoriAset)))
                        {
                            <option value="@k" selected="@(kategoriTerpilih == k)">@k</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select">
                        <option value="">Semua Status</option>
                        @foreach (SistemHRD.Models.Enums.StatusAset s in Enum.GetValues(typeof(SistemHRD.Models.Enums.StatusAset)))
                        {
                            <option value="@s" selected="@(statusTerpilih == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Kondisi</label>
                    <select name="kondisi" class="form-select">
                        <option value="">Semua Kondisi</option>
                        @foreach (SistemHRD.Models.Enums.KondisiAset kd in Enum.GetValues(typeof(SistemHRD.Models.Enums.KondisiAset)))
                        {
                            <option value="@kd" selected="@(kondisiTerpilih == kd)">@kd</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Filter
                    </button>
                    <a asp-action="Daftar" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NOMOR & NAMA ASET</th>
                            <th>KATEGORI</th>
                            <th>MERK / MODEL</th>
                            <th>NILAI PEROLEHAN</th>
                            <th>KONDISI</th>
                            <th>STATUS</th>
                            <th>PEMEGANG SAAT INI</th>
                            <th class="text-end">AKSI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DaftarAset.Any())
                        {
                            @foreach (var a in Model.DaftarAset)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@a.NamaAset</div>
                                        <div class="text-muted small"><code>@a.NomorAset</code></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@a.Kategori</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@(a.MerkModel ?? "-")</div>
                                        <div class="text-muted small">SN: @(a.NomorSeri ?? "-")</div>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">Rp @a.NilaiPerolehan.ToString("N0")</div>
                                        <div class="text-muted small">Beli: @a.TanggalPembelian.ToString("dd/MM/yyyy")</div>
                                    </td>
                                    <td>
                                        @switch (a.Kondisi)
                                        {
                                            case SistemHRD.Models.Enums.KondisiAset.SangatBaik:
                                                <span class="badge bg-success">Sangat Baik</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.Baik:
                                                <span class="badge bg-primary">Baik</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.RusakRingan:
                                                <span class="badge bg-warning text-dark">Rusak Ringan</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.RusakBerat:
                                                <span class="badge bg-danger">Rusak Berat</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.Hilang:
                                                <span class="badge bg-dark">Hilang</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @switch (a.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusAset.Tersedia:
                                                <span class="badge bg-info text-dark">Tersedia</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.Digunakan:
                                                <span class="badge bg-success">Digunakan</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.DalamPerbaikan:
                                                <span class="badge bg-warning text-dark">Dalam Perbaikan</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.Dihapuskan:
                                                <span class="badge bg-secondary">Dihapuskan</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(a.NamaPemegang))
                                        {
                                            <div class="small fw-semibold text-dark">@a.NamaPemegang</div>
                                            <div class="text-muted small"><code>@a.NIKPemegang</code></div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Di Gudang</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                Kelola
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a class="dropdown-item" asp-action="DetailAset" asp-route-id="@a.Id">
                                                        <i data-lucide="eye" class="me-2" style="width:14px;height:14px;display:inline-block;"></i>Detail & Penyerahan
                                                    </a>
                                                </li>
                                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("HRD"))
                                                {
                                                    <li>
                                                        <a class="dropdown-item" asp-action="UbahAset" asp-route-id="@a.Id">
                                                            <i data-lucide="edit-3" class="me-2" style="width:14px;height:14px;display:inline-block;"></i>Ubah Aset
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-action="HapusAset" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Apakah Anda yakin ingin menghapus aset ini?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i data-lucide="trash-2" class="me-2" style="width:14px;height:14px;display:inline-block;"></i>Hapus Aset
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i data-lucide="inbox" class="d-block mx-auto mb-2 text-muted" style="width:40px;height:40px;"></i>
                                    Tidak ada data aset inventaris yang sesuai dengan filter.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman (Total @Model.TotalData aset)
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Daftar"
                               asp-route-halaman="@(Model.HalamanSaatIni - 1)"
                               asp-route-kategori="@kategoriTerpilih"
                               asp-route-status="@statusTerpilih"
                               asp-route-kondisi="@kondisiTerpilih"
                               asp-route-kataKunci="@kataKunci">Sebelumnya</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Daftar"
                                   asp-route-halaman="@i"
                                   asp-route-kategori="@kategoriTerpilih"
                                   asp-route-status="@statusTerpilih"
                                   asp-route-kondisi="@kondisiTerpilih"
                                   asp-route-kataKunci="@kataKunci">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Daftar"
                               asp-route-halaman="@(Model.HalamanSaatIni + 1)"
                               asp-route-kategori="@kategoriTerpilih"
                               asp-route-status="@statusTerpilih"
                               asp-route-kondisi="@kondisiTerpilih"
                               asp-route-kataKunci="@kataKunci">Berikutnya</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
