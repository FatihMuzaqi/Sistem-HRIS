@model SistemHRD.ViewModels.DasborViewModel
@using SistemHRD.Common.Constants
@{
    ViewData["Title"] = "Dasbor";
    Layout = "_Layout";
}

<!-- Header Dasbor -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Dasbor @Model.PeranPengguna</h4>
        <div class="text-muted small d-flex align-items-center gap-2">
            <span>Selamat datang kembali, <strong>@Model.NamaPengguna</strong></span>
            <span>&bull;</span>
            <span class="badge @(Model.IsSuperAdmin ? "bg-dark" : "bg-emerald text-white")">@Model.PeranPengguna</span>
            @if (!string.IsNullOrEmpty(Model.NamaPerusahaan))
            {
                <span>&bull;</span>
                <span class="text-emerald fw-semibold">@Model.NamaPerusahaan (@Model.KodePerusahaan)</span>
            }
        </div>
    </div>

    @if (Model.IsSuperAdmin)
    {
        <!-- Form Pengalih Konteks Perusahaan Khusus SuperAdmin -->
        <div class="mt-3 mt-md-0">
            <form asp-controller="Dasbor" asp-action="GantiPerusahaanAktif" method="post" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <label class="form-label small mb-0 fw-semibold text-muted text-nowrap">Filter Tenant:</label>
                <select name="perusahaanId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- Seluruh Platform (Global) --</option>
                    @foreach (var prsh in Model.DaftarPerusahaanPlatform)
                    {
                        <option value="@prsh.Id">@prsh.NamaPerusahaan (@prsh.KodePerusahaan)</option>
                    }
                </select>
            </form>
        </div>
    }
</div>

@if (Model.IsSuperAdmin)
{
    <!-- KARTU STATISTIK SUPERADMIN (PLATFORM LEVEL) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i data-lucide="building-2" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Total Perusahaan</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalPerusahaanAktif</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i data-lucide="users-2" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Total Pengguna Sistem</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalPenggunaSistem</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i data-lucide="activity" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Aktivitas Hari Ini</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalAktivitasHariIni</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i data-lucide="server" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Status Database</div>
                    <div class="fs-6 fw-bold text-success">MySQL (Normal)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABEL & VISUALISASI PLATFORM SUPERADMIN -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i data-lucide="building" style="width: 18px; height: 18px; color: var(--primary-emerald);"></i>
                        <span>Daftar Perusahaan Terdaftar (Multi-Tenant)</span>
                    </h6>
                    <span class="badge bg-light text-muted fw-normal">@Model.DaftarPerusahaanPlatform.Count Entitas</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Kode</th>
                                    <th>Nama Perusahaan</th>
                                    <th>Email Kontak</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prsh in Model.DaftarPerusahaanPlatform)
                                {
                                    <tr>
                                        <td><span class="badge bg-light text-dark fw-bold">@prsh.KodePerusahaan</span></td>
                                        <td class="fw-semibold">@prsh.NamaPerusahaan</td>
                                        <td class="text-muted">@(prsh.Email ?? "-")</td>
                                        <td>
                                            @if (prsh.StatusAktif)
                                            {
                                                <span class="badge badge-emerald">Aktif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Nonaktif</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i data-lucide="shield-check" style="width: 18px; height: 18px; color: var(--primary-emerald);"></i>
                        <span>Audit Log Sistem Terkini</span>
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush small">
                        @if (Model.LogAktivitasTerakhir.Any())
                        {
                            @foreach (var log in Model.LogAktivitasTerakhir)
                            {
                                <div class="list-group-item py-3 px-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge @(log.Aksi.Contains("GAGAL") ? "bg-danger" : "badge-emerald")">@log.Aksi</span>
                                        <span class="text-muted" style="font-size: 0.75rem;">@log.Waktu.ToLocalTime().ToString("dd MMM HH:mm")</span>
                                    </div>
                                    <div class="fw-semibold text-dark">@log.NamaPengguna</div>
                                    <div class="text-muted text-truncate" style="max-width: 320px;">@log.DataBaru</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">Belum ada catatan aktivitas audit.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- KARTU STATISTIK TENANT (HRD / MANAGER / FINANCE / KARYAWAN) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-emerald">
                    <i data-lucide="users" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Total Akun Karyawan</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalKaryawanPerusahaan</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-blue">
                    <i data-lucide="check-circle" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Presensi Hadir Hari Ini</div>
                    <div class="fs-4 fw-bold text-dark">1 (Anda)</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-amber">
                    <i data-lucide="calendar" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Pengajuan Cuti Pending</div>
                    <div class="fs-4 fw-bold text-dark">0</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card-stat d-flex align-items-center gap-3">
                <div class="stat-icon-wrapper stat-icon-purple">
                    <i data-lucide="building" style="width: 24px; height: 24px;"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">ID Perusahaan</div>
                    <div class="fs-6 fw-bold text-dark">@Model.KodePerusahaan</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABEL & AKTIVITAS PERUSAHAAN INI -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i data-lucide="users" style="width: 18px; height: 18px; color: var(--primary-emerald);"></i>
                        <span>Pengguna Terdaftar di @Model.NamaPerusahaan</span>
                    </h6>
                    <span class="badge bg-light text-muted fw-normal">Isolasi Tenant Aktif</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Nama Lengkap</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usr in Model.DaftarPenggunaTenant)
                                {
                                    <tr>
                                        <td class="fw-semibold">@usr.NamaLengkap</td>
                                        <td class="text-muted">@usr.Email</td>
                                        <td><span class="badge badge-emerald">Aktif</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i data-lucide="activity" style="width: 18px; height: 18px; color: var(--primary-emerald);"></i>
                        <span>Aktivitas Tenant Ini</span>
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush small">
                        @if (Model.LogAktivitasTerakhir.Any())
                        {
                            @foreach (var log in Model.LogAktivitasTerakhir)
                            {
                                <div class="list-group-item py-3 px-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge @(log.Aksi.Contains("GAGAL") ? "bg-danger" : "badge-emerald")">@log.Aksi</span>
                                        <span class="text-muted" style="font-size: 0.75rem;">@log.Waktu.ToLocalTime().ToString("dd MMM HH:mm")</span>
                                    </div>
                                    <div class="fw-semibold text-dark">@log.NamaPengguna</div>
                                    <div class="text-muted text-truncate" style="max-width: 320px;">@log.DataBaru</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted">Belum ada aktivitas untuk perusahaan ini.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
