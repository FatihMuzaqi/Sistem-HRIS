@{
    ViewData["Title"] = "Akses Ditolak (403)";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card shadow-sm border-0 rounded-4 p-5 bg-white">
                    <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-4 mx-auto" style="width: 72px; height: 72px; display: flex; align-items: center; justify-content: center;">
                        <i data-lucide="shield-alert" style="width: 40px; height: 40px;"></i>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">Akses Ditolak</h4>
                    <p class="text-muted small mb-4">
                        Maaf, akun Anda tidak memiliki hak akses atau izin yang memadai untuk membuka halaman atau data perusahaan ini.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                        <a asp-controller="Dasbor" asp-action="Index" class="btn btn-emerald d-flex align-items-center justify-content-center gap-2">
                            <i data-lucide="arrow-left" style="width: 18px; height: 18px;"></i>
                            <span>Kembali ke Dasbor</span>
                        </a>

                        <form asp-controller="Autentikasi" asp-action="Keluar" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                                <i data-lucide="log-out" style="width: 18px; height: 18px;"></i>
                                <span>Ganti Akun</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
