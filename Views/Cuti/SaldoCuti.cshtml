@model List<SistemHRD.ViewModels.SaldoCutiViewModel>

@{
    ViewData["Title"] = "Manajemen Saldo Cuti Karyawan";
    var tahun = (int)(ViewBag.Tahun ?? DateTime.Today.Year);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Manajemen Saldo Cuti</h1>
        <p class="text-muted small mb-0">Atur alokasi hak cuti tahunan, riwayat cuti terpakai, dan sisa kuota cuti karyawan periode @tahun.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <form asp-action="InisialisasiSaldoMassal" method="post" class="d-inline" onsubmit="return confirm('Inisialisasi saldo cuti tahunan untuk seluruh karyawan aktif periode @tahun?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tahun" value="@tahun" />
            <button type="submit" class="btn btn-outline-emerald d-inline-flex align-items-center gap-2">
                <i data-lucide="sparkles" style="width: 16px; height: 16px;"></i>
                <span>Inisialisasi Massal (@tahun)</span>
            </button>
        </form>
        <button type="button" class="btn btn-emerald d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalAturSaldo">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            <span>Atur Saldo Karyawan</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Kembali</span>
        </a>
    </div>
</div>

<!-- Filter Tahun & Departemen -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Periode Tahun</label>
                <select name="tahun" class="form-select form-select-sm">
                    @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == tahun)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Departemen</label>
                <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select form-select-sm">
                    <option value="">-- Semua Departemen --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-emerald w-100">
                    <i data-lucide="search" style="width: 16px; height: 16px;" class="me-1"></i>
                    Tampilkan Saldo
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">Karyawan</th>
                        <th>Departemen</th>
                        <th>Jenis Cuti</th>
                        <th>Periode</th>
                        <th class="text-center">Hak Cuti</th>
                        <th class="text-center">Terpakai</th>
                        <th class="text-center">Sisa Saldo</th>
                        <th class="pe-3">Catatan</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-slate-800">@item.NamaKaryawan</div>
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@item.NomorIndukKaryawan</span>
                                </td>
                                <td>@item.NamaDepartemen</td>
                                <td>
                                    <span class="fw-medium text-slate-800">@item.NamaJenisCuti</span>
                                    <span class="badge bg-light text-secondary border font-monospace ms-1">@item.KodeJenisCuti</span>
                                </td>
                                <td class="font-monospace fw-bold">@item.PeriodeTahun</td>
                                <td class="text-center fw-bold text-slate-700">@item.JumlahHakCuti Hari</td>
                                <td class="text-center fw-bold text-warning">@item.CutiTerpakai Hari</td>
                                <td class="text-center fw-bold text-emerald">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 font-monospace fs-6">
                                        @item.SisaCuti Hari
                                    </span>
                                </td>
                                <td class="pe-3 small text-muted">@(item.Catatan ?? "-")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Belum ada saldo cuti untuk periode tahun @tahun. Klik 'Inisialisasi Massal (@tahun)' untuk membuat otomatis.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Atur Saldo Cuti Individual -->
<div class="modal fade" id="modalAturSaldo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AturSaldoCuti" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-slate-800">Atur Saldo Cuti Karyawan</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Pilih Karyawan <span class="text-danger">*</span></label>
                            <select name="KaryawanId" asp-items="ViewBag.DaftarKaryawan" class="form-select" required>
                                <option value="">-- Pilih Karyawan --</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Pilih Jenis Cuti <span class="text-danger">*</span></label>
                            <select name="JenisCutiId" asp-items="ViewBag.DaftarJenisCuti" class="form-select" required>
                                <option value="">-- Pilih Jenis Cuti --</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Periode Tahun <span class="text-danger">*</span></label>
                            <input type="number" name="PeriodeTahun" class="form-control font-monospace" value="@tahun" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Jumlah Hak Cuti (Hari) <span class="text-danger">*</span></label>
                            <input type="number" name="JumlahHakCuti" class="form-control" value="12" min="0" max="365" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Catatan / Keterangan</label>
                            <input type="text" name="Catatan" class="form-control" placeholder="Penyesuaian kuota cuti khusus..." />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-emerald">Simpan Saldo Cuti</button>
                </div>
            </form>
        </div>
    </div>
</div>
