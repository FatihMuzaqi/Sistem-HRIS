@model SistemHRD.ViewModels.LaporanKeterlambatanViewModel
@{
    ViewData["Title"] = "Laporan Analisis Keterlambatan";
    var tMulai = ViewBag.TanggalMulai as string ?? Model.TanggalMulai.ToString("yyyy-MM-dd");
    var tSelesai = ViewBag.TanggalSelesai as string ?? Model.TanggalSelesai.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Keterlambatan</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Kedisiplinan & Analisis Keterlambatan</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Mulai</label>
                    <input type="date" name="tanggalMulai" value="@tMulai" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Selesai</label>
                    <input type="date" name="tanggalSelesai" value="@tSelesai" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Keterlambatan" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-warning p-3">
                <span class="text-muted small fw-semibold">TOTAL KEJADIAN KETERLAMBATAN</span>
                <h3 class="fw-bold mb-0 text-warning">@Model.TotalKasusKeterlambatan Kasus</h3>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-danger p-3">
                <span class="text-muted small fw-semibold">AKUMULASI WAKTU TERLAMBAT</span>
                <h3 class="fw-bold mb-0 text-danger">@Model.TotalAkumulasiMenitTerlambat Menit</h3>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>TANGGAL</th>
                            <th>NIK & NAMA KARYAWAN</th>
                            <th>DEPARTEMEN</th>
                            <th>JAM JADWAL MASUK</th>
                            <th>JAM REALISASI MASUK</th>
                            <th>DURASI TERLAMBAT</th>
                            <th>ESTIMASI PENYESUAIAN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataKeterlambatan.Any())
                        {
                            @foreach (var k in Model.DataKeterlambatan)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@k.Tanggal.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">@k.Tanggal.ToString("dddd")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@k.NamaKaryawan</div>
                                        <div class="text-muted small"><code>@k.NIK</code></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@k.NamaDepartemen</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@(k.JamJadwalMasuk.HasValue ? k.JamJadwalMasuk.Value.ToString(@"hh\:mm") : "08:00")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-danger">@(k.JamRealisasiMasuk.HasValue ? k.JamRealisasiMasuk.Value.ToString(@"hh\:mm") : "-")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger">@k.MenitTerlambat Menit</span>
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-dark">Rp @k.EstimasiDenda.ToString("N0")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i data-lucide="check-circle" class="d-block mx-auto mb-2 text-success" style="width:36px;height:36px;"></i>
                                    Tidak ada catatan keterlambatan pada periode yang dipilih. Tingkat kedisiplinan 100%!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Keterlambatan"
                                   asp-route-halaman="@i"
                                   asp-route-tanggalMulai="@tMulai"
                                   asp-route-tanggalSelesai="@tSelesai"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
