@model SistemHRD.ViewModels.LaporanKaryawanViewModel
@{
    ViewData["Title"] = "Laporan Data Karyawan";
    var statusTerpilih = ViewBag.StatusTerpilih as SistemHRD.Models.Enums.StatusKaryawan?;
    var kataKunci = ViewBag.KataKunci as string;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Karyawan</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Data & Master Karyawan</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <a asp-action="EksporKaryawan"
               asp-route-departemenId="@Model.DepartemenIdTerpilih"
               asp-route-status="@statusTerpilih"
               asp-route-kataKunci="@kataKunci"
               class="btn btn-success text-white">
                <i data-lucide="download" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Ekspor CSV / Excel
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Pencarian</label>
                    <input type="text" name="kataKunci" value="@kataKunci" class="form-control" placeholder="NIK, Nama, atau Email..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status Kepegawaian</label>
                    <select name="status" class="form-select">
                        <option value="">Semua Status</option>
                        @foreach (SistemHRD.Models.Enums.StatusKaryawan s in Enum.GetValues(typeof(SistemHRD.Models.Enums.StatusKaryawan)))
                        {
                            <option value="@s" selected="@(statusTerpilih == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Karyawan" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
            <h6 class="fw-bold mb-0 text-dark">Data Karyawan (@Model.TotalData Karyawan Ditemukan)</h6>
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
                <i data-lucide="printer" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NIK & NAMA KARYAWAN</th>
                            <th>KONTAK (EMAIL / TELP)</th>
                            <th>DEPARTEMEN</th>
                            <th>JABATAN</th>
                            <th>GENDER</th>
                            <th>TANGGAL MASUK</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataKaryawan.Any())
                        {
                            @foreach (var k in Model.DataKaryawan)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@k.NamaLengkap</div>
                                        <div class="text-muted small"><code>@k.NIK</code></div>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@k.Email</div>
                                        <div class="text-muted small">@k.NomorTelepon</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@k.NamaDepartemen</span>
                                    </td>
                                    <td>
                                        <span class="small fw-semibold text-dark">@k.NamaJabatan</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@k.JenisKelamin</span>
                                    </td>
                                    <td>
                                        <span class="small text-dark">@k.TanggalMasuk.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td>
                                        @switch (k.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusKaryawan.Tetap:
                                                <span class="badge bg-success">Tetap</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKaryawan.Kontrak:
                                                <span class="badge bg-primary">Kontrak</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKaryawan.Percobaan:
                                                <span class="badge bg-warning text-dark">Percobaan</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKaryawan.Magang:
                                                <span class="badge bg-info text-dark">Magang</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKaryawan.Nonaktif:
                                                <span class="badge bg-secondary">Nonaktif</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Tidak ada data karyawan yang cocok dengan kriteria filter.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman (Total @Model.TotalData karyawan)
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Karyawan"
                                   asp-route-halaman="@i"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih"
                                   asp-route-status="@statusTerpilih"
                                   asp-route-kataKunci="@kataKunci">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
