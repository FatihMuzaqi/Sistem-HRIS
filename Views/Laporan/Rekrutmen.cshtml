@model SistemHRD.ViewModels.LaporanRekrutmenViewModel
@{
    ViewData["Title"] = "Laporan Rekrutmen & Pelamar";
    var tMulai = Model.TanggalMulai?.ToString("yyyy-MM-dd");
    var tSelesai = Model.TanggalSelesai?.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Rekrutmen</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Pengadaan SDM & Rekrutmen</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Mulai</label>
                    <input type="date" name="tanggalMulai" value="@tMulai" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Selesai</label>
                    <input type="date" name="tanggalSelesai" value="@tSelesai" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Lowongan Pekerjaan</label>
                    <select name="lowonganId" asp-items="ViewBag.DaftarLowongan" class="form-select">
                        <option value="">Semua Lowongan</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Rekrutmen" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary p-3">
                <span class="text-muted small fw-semibold">TOTAL PELAMAR MASUK</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.TotalPelamarMasuk Kandidat</h3>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-info p-3">
                <span class="text-muted small fw-semibold">LOLOS TAHAP WAWANCARA</span>
                <h3 class="fw-bold mb-0 text-info">@Model.TotalLolosWawancara Kandidat</h3>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success p-3">
                <span class="text-muted small fw-semibold">KANDIDAT DITERIMA (HIRED)</span>
                <h3 class="fw-bold mb-0 text-success">@Model.TotalKandidatDiterima Kandidat</h3>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">Daftar Pelamar (@Model.TotalData Pelamar)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NO. REGISTRASI</th>
                            <th>NAMA KANDIDAT</th>
                            <th>POSISI LOWONGAN</th>
                            <th>PENDIDIKAN</th>
                            <th>PENGALAMAN</th>
                            <th>TANGGAL MELAMAR</th>
                            <th>STATUS SELEKSI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataRekrutmen.Any())
                        {
                            @foreach (var p in Model.DataRekrutmen)
                            {
                                <tr>
                                    <td><code>@p.NomorRegistrasi</code></td>
                                    <td><span class="fw-bold text-dark">@p.NamaPelamar</span></td>
                                    <td><span class="badge bg-light text-dark border">@p.PosisiLowongan</span></td>
                                    <td><span class="small text-dark">@p.Pendidikan</span></td>
                                    <td><span class="small text-muted">@p.PengalamanTahun.ToString("0.0") Tahun</span></td>
                                    <td><span class="small text-dark">@p.TanggalMelamar.ToString("dd MMM yyyy")</span></td>
                                    <td>
                                        @switch (p.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusPelamar.Baru:
                                                <span class="badge bg-secondary">Baru</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.SeleksiAdministrasi:
                                                <span class="badge bg-info text-dark">Seleksi Administrasi</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.LolosAdministrasi:
                                                <span class="badge bg-primary">Lolos Administrasi</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.Wawancara:
                                                <span class="badge bg-warning text-dark">Wawancara</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.PenawaranKerja:
                                                <span class="badge bg-info text-dark">Penawaran Kerja</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.Diterima:
                                                <span class="badge bg-success">Diterima (Hired)</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelamar.Ditolak:
                                                <span class="badge bg-danger">Ditolak</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Tidak ada data pelamar pada kriteria filter yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Rekrutmen"
                                   asp-route-halaman="@i"
                                   asp-route-tanggalMulai="@tMulai"
                                   asp-route-tanggalSelesai="@tSelesai"
                                   asp-route-lowonganId="@Model.LowonganIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
