@model SistemHRD.ViewModels.LaporanPelatihanPusatViewModel
@{
    ViewData["Title"] = "Laporan Pelatihan & Pengembangan";
    var tMulai = Model.TanggalMulai?.ToString("yyyy-MM-dd");
    var tSelesai = Model.TanggalSelesai?.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pelatihan</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Program Pelatihan & Pengembangan SDM</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Mulai</label>
                    <input type="date" name="tanggalMulai" value="@tMulai" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Selesai</label>
                    <input type="date" name="tanggalSelesai" value="@tSelesai" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Pelatihan" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-4 border-primary p-3">
                <span class="text-muted small fw-semibold">TOTAL PROGRAM PELATIHAN</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.TotalProgram Program</h3>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-4 border-info p-3">
                <span class="text-muted small fw-semibold">PESERTA MENGIKUTI</span>
                <h3 class="fw-bold mb-0 text-info">@Model.TotalPeserta Peserta</h3>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-4 border-success p-3">
                <span class="text-muted small fw-semibold">PESERTA LULUS KOMPETEN</span>
                <h3 class="fw-bold mb-0 text-success">@Model.TotalPesertaLulus Peserta</h3>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-4 border-warning p-3">
                <span class="text-muted small fw-semibold">TOTAL BIAYA PELATIHAN</span>
                <h4 class="fw-bold mb-0 text-dark">Rp @Model.TotalBiayaPelatihan.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">Daftar Pelatihan (@Model.TotalData Program)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>KODE & NAMA PROGRAM</th>
                            <th>PENYELENGGARA</th>
                            <th>METODE</th>
                            <th>JADWAL</th>
                            <th class="text-center">PESERTA</th>
                            <th class="text-center">LULUS</th>
                            <th>STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataPelatihan.Any())
                        {
                            @foreach (var p in Model.DataPelatihan)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@p.NamaProgram</div>
                                        <div class="text-muted small"><code>@p.KodeProgram</code></div>
                                    </td>
                                    <td><span class="small fw-semibold text-dark">@p.Penyelenggara</span></td>
                                    <td><span class="badge bg-light text-dark border">@p.Metode</span></td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@p.TanggalMulai.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">s/d @p.TanggalSelesai.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td class="text-center fw-bold text-primary">@p.JumlahPeserta</td>
                                    <td class="text-center fw-bold text-success">@p.JumlahLulus</td>
                                    <td>
                                        @switch (p.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusPelatihan.Draf:
                                                <span class="badge bg-secondary">Draf</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelatihan.PendaftaranDibuka:
                                                <span class="badge bg-info text-dark">Pendaftaran Dibuka</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelatihan.Berlangsung:
                                                <span class="badge bg-primary">Berlangsung</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelatihan.Selesai:
                                                <span class="badge bg-success">Selesai</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusPelatihan.Dibatalkan:
                                                <span class="badge bg-danger">Dibatalkan</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Tidak ada data program pelatihan pada periode yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Pelatihan"
                                   asp-route-halaman="@i"
                                   asp-route-tanggalMulai="@tMulai"
                                   asp-route-tanggalSelesai="@tSelesai"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
