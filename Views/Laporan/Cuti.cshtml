@model SistemHRD.ViewModels.LaporanCutiViewModel
@{
    ViewData["Title"] = "Laporan Penggunaan Cuti";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Cuti</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Penggunaan Cuti Karyawan</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-muted">Tahun</label>
                    <select name="tahun" class="form-select">
                        @for (int t = DateTime.Today.Year; t >= DateTime.Today.Year - 3; t--)
                        {
                            <option value="@t" selected="@(Model.TahunTerpilih == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Jenis Cuti</label>
                    <select name="jenisCutiId" asp-items="ViewBag.DaftarJenisCuti" class="form-select">
                        <option value="">Semua Jenis Cuti</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Cuti" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success p-3">
                <span class="text-muted small fw-semibold">TOTAL HARI CUTI DISETUJUI</span>
                <h3 class="fw-bold mb-0 text-success">@Model.TotalHariCutiDisetujui Hari</h3>
            </div>
        </div>
        <div class="col-sm-8">
            <div class="card border-0 shadow-sm p-3">
                <span class="text-muted small fw-semibold mb-2 d-block">DISTRIBUSI JENIS CUTI</span>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var j in Model.RekapPerJenisCuti)
                    {
                        <span class="badge bg-light text-dark border p-2">
                            @j.Key: <strong>@j.Value Hari</strong>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NOMOR PENGAJUAN</th>
                            <th>NIK & NAMA KARYAWAN</th>
                            <th>DEPARTEMEN</th>
                            <th>JENIS CUTI</th>
                            <th>PERIODE CUTI</th>
                            <th>DURASI</th>
                            <th>STATUS</th>
                            <th>ALASAN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataCuti.Any())
                        {
                            @foreach (var c in Model.DataCuti)
                            {
                                <tr>
                                    <td><code>@c.NomorPengajuan</code></td>
                                    <td>
                                        <div class="fw-semibold text-dark">@c.NamaKaryawan</div>
                                        <div class="text-muted small"><code>@c.NIK</code></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@c.NamaDepartemen</span></td>
                                    <td><span class="fw-semibold text-primary">@c.JenisCuti</span></td>
                                    <td>
                                        <div class="small fw-semibold text-dark">@c.TanggalMulai.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">s/d @c.TanggalSelesai.ToString("dd MMM yyyy")</div>
                                    </td>
                                    <td><span class="badge bg-secondary">@c.DurasiHari Hari</span></td>
                                    <td>
                                        @if (c.Status == "Disetujui")
                                        {
                                            <span class="badge bg-success">Disetujui</span>
                                        }
                                        else if (c.Status.Contains("Menunggu"))
                                        {
                                            <span class="badge bg-warning text-dark">@c.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@c.Status</span>
                                        }
                                    </td>
                                    <td><div class="small text-muted" style="max-width:200px;">@c.Alasan</div></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    Tidak ada pengajuan cuti pada kriteria filter yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Cuti"
                                   asp-route-halaman="@i"
                                   asp-route-tahun="@Model.TahunTerpilih"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih"
                                   asp-route-jenisCutiId="@Model.JenisCutiIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
