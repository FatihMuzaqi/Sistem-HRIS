@model SistemHRD.ViewModels.LaporanAsetPusatViewModel
@{
    ViewData["Title"] = "Laporan Inventaris Aset";
    var kategoriTerpilih = ViewBag.KategoriTerpilih as SistemHRD.Models.Enums.KategoriAset?;
    var statusTerpilih = ViewBag.StatusTerpilih as SistemHRD.Models.Enums.StatusAset?;
    var kondisiTerpilih = ViewBag.KondisiTerpilih as SistemHRD.Models.Enums.KondisiAset?;
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Aset</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Inventaris & Nilai Aset Perusahaan</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <a asp-action="EksporAset"
               asp-route-kategori="@kategoriTerpilih"
               asp-route-status="@statusTerpilih"
               asp-route-kondisi="@kondisiTerpilih"
               class="btn btn-success text-white">
                <i data-lucide="download" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Ekspor CSV / Excel
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Kategori</label>
                    <select name="kategori" class="form-select">
                        <option value="">Semua Kategori</option>
                        @foreach (SistemHRD.Models.Enums.KategoriAset k in Enum.GetValues(typeof(SistemHRD.Models.Enums.KategoriAset)))
                        {
                            <option value="@k" selected="@(kategoriTerpilih == k)">@k</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Status</label>
                    <select name="status" class="form-select">
                        <option value="">Semua Status</option>
                        @foreach (SistemHRD.Models.Enums.StatusAset s in Enum.GetValues(typeof(SistemHRD.Models.Enums.StatusAset)))
                        {
                            <option value="@s" selected="@(statusTerpilih == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Kondisi</label>
                    <select name="kondisi" class="form-select">
                        <option value="">Semua Kondisi</option>
                        @foreach (SistemHRD.Models.Enums.KondisiAset kd in Enum.GetValues(typeof(SistemHRD.Models.Enums.KondisiAset)))
                        {
                            <option value="@kd" selected="@(kondisiTerpilih == kd)">@kd</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Aset" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-primary p-3">
                <span class="text-muted small fw-semibold">TOTAL UNIT INVENTARIS</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.TotalUnitAset Unit</h3>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-success p-3">
                <span class="text-muted small fw-semibold">TOTAL NILAI BUKU / PEROLEHAN</span>
                <h3 class="fw-bold mb-0 text-success">Rp @Model.TotalNilaiInventaris.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">Data Inventaris Aset (@Model.TotalData Aset)</h6>
            <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
                <i data-lucide="printer" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>NOMOR ASET</th>
                            <th>NAMA ASET</th>
                            <th>KATEGORI</th>
                            <th>MERK / MODEL</th>
                            <th>TANGGAL BELI</th>
                            <th>NILAI PEROLEHAN</th>
                            <th>KONDISI</th>
                            <th>STATUS</th>
                            <th>PEMEGANG SAAT INI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataAset.Any())
                        {
                            @foreach (var a in Model.DataAset)
                            {
                                <tr>
                                    <td><code>@a.NomorAset</code></td>
                                    <td><span class="fw-bold text-dark">@a.NamaAset</span></td>
                                    <td><span class="badge bg-light text-dark border">@a.Kategori</span></td>
                                    <td><span class="small text-dark">@(a.MerkModel ?? "-")</span></td>
                                    <td><span class="small text-muted">@a.TanggalBeli.ToString("dd MMM yyyy")</span></td>
                                    <td><span class="fw-semibold text-dark">Rp @a.NilaiPerolehan.ToString("N0")</span></td>
                                    <td>
                                        @switch (a.Kondisi)
                                        {
                                            case SistemHRD.Models.Enums.KondisiAset.SangatBaik:
                                                <span class="badge bg-success">Sangat Baik</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.Baik:
                                                <span class="badge bg-primary">Baik</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.RusakRingan:
                                                <span class="badge bg-warning text-dark">Rusak Ringan</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.RusakBerat:
                                                <span class="badge bg-danger">Rusak Berat</span>
                                                break;
                                            case SistemHRD.Models.Enums.KondisiAset.Hilang:
                                                <span class="badge bg-dark">Hilang</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @switch (a.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusAset.Tersedia:
                                                <span class="badge bg-info text-dark">Tersedia</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.Digunakan:
                                                <span class="badge bg-success">Digunakan</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.DalamPerbaikan:
                                                <span class="badge bg-warning text-dark">Perbaikan</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusAset.Dihapuskan:
                                                <span class="badge bg-secondary">Dihapus</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(a.NamaPemegang) && a.NamaPemegang != "-")
                                        {
                                            <div class="fw-semibold text-dark small">@a.NamaPemegang</div>
                                            <div class="text-muted small">@a.DepartemenPemegang</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Gudang / Bebas</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    Tidak ada data aset pada kriteria filter yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Aset"
                                   asp-route-halaman="@i"
                                   asp-route-kategori="@kategoriTerpilih"
                                   asp-route-status="@statusTerpilih"
                                   asp-route-kondisi="@kondisiTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
