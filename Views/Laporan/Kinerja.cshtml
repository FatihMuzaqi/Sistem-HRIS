@model SistemHRD.ViewModels.LaporanKinerjaPusatViewModel
@{
    ViewData["Title"] = "Laporan Evaluasi Kinerja (KPI)";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Kinerja</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Evaluasi & Penilaian Kinerja Karyawan (KPI)</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted">Periode Penilaian</label>
                    <select name="periodeId" asp-items="ViewBag.DaftarPeriode" class="form-select">
                        <option value="">Semua Periode</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Kinerja" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary p-3">
                <span class="text-muted small fw-semibold">RATA-RATA SKOR PERUSAHAAN</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.RataRataSkorPerusahaan / 100</h3>
            </div>
        </div>
        <div class="col-sm-8">
            <div class="card border-0 shadow-sm p-3">
                <span class="text-muted small fw-semibold mb-2 d-block">DISTRIBUSI PREDIKAT KINERJA</span>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var p in Model.DistribusiPredikat)
                    {
                        <span class="badge bg-light text-dark border p-2">
                            @p.Key: <strong>@p.Value Karyawan</strong>
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">Data Penilaian Kinerja (@Model.TotalData Evaluasi)</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>PERIODE</th>
                            <th>NIK & NAMA KARYAWAN</th>
                            <th>DEPARTEMEN</th>
                            <th>PENILAI / MANAGER</th>
                            <th>TANGGAL PENILAIAN</th>
                            <th>SKOR AKHIR</th>
                            <th>PREDIKAT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataKinerja.Any())
                        {
                            @foreach (var k in Model.DataKinerja)
                            {
                                <tr>
                                    <td><span class="fw-semibold text-dark">@k.NamaPeriode</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">@k.NamaKaryawan</div>
                                        <div class="text-muted small"><code>@k.NIK</code></div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@k.NamaDepartemen</span></td>
                                    <td><span class="small text-dark">@k.NamaPenilai</span></td>
                                    <td><span class="small text-muted">@k.TanggalPenilaian.ToString("dd MMM yyyy")</span></td>
                                    <td>
                                        <span class="fw-bold fs-6 @(k.TotalSkorAkhir >= 80 ? "text-success" : (k.TotalSkorAkhir >= 60 ? "text-warning" : "text-danger"))">
                                            @k.TotalSkorAkhir.ToString("0.0")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@k.PredikatKinerja</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Tidak ada catatan penilaian kinerja pada kriteria filter yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Kinerja"
                                   asp-route-halaman="@i"
                                   asp-route-periodeId="@Model.PeriodeIdTerpilih"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
