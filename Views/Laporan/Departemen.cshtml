@model SistemHRD.ViewModels.LaporanDistribusiDepartemenViewModel
@{
    ViewData["Title"] = "Laporan Distribusi Departemen";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Departemen</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Distribusi Organisasi & Departemen</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak Laporan
            </button>
        </div>
    </div>

    <!-- Stat Summary -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-primary">
                <div class="card-body">
                    <span class="text-muted small fw-semibold">TOTAL DEPARTEMEN</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.RekapDepartemen.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success">
                <div class="card-body">
                    <span class="text-muted small fw-semibold">TOTAL KARYAWAN AKTIF</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalSeluruhKaryawan Orang</h3>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm border-start border-4 border-info">
                <div class="card-body">
                    <span class="text-muted small fw-semibold">RATA-RATA / DEPARTEMEN</span>
                    <h3 class="fw-bold mb-0 text-dark">
                        @(Model.RekapDepartemen.Count > 0 ? (Model.TotalSeluruhKaryawan / Model.RekapDepartemen.Count).ToString() : "0") Orang
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>KODE</th>
                            <th>NAMA DEPARTEMEN</th>
                            <th class="text-center">TOTAL KARYAWAN</th>
                            <th class="text-center">KARYAWAN TETAP</th>
                            <th class="text-center">KONTRAK / PROBATION</th>
                            <th class="text-center">LAKI-LAKI</th>
                            <th class="text-center">PEREMPUAN</th>
                            <th class="text-end">PORSI ORGANISASI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RekapDepartemen.Any())
                        {
                            @foreach (var d in Model.RekapDepartemen)
                            {
                                var persen = Model.TotalSeluruhKaryawan > 0
                                    ? Math.Round(((decimal)d.TotalKaryawan / Model.TotalSeluruhKaryawan) * 100, 1)
                                    : 0;
                                <tr>
                                    <td><code>@d.KodeDepartemen</code></td>
                                    <td><span class="fw-bold text-dark">@d.NamaDepartemen</span></td>
                                    <td class="text-center fw-bold text-primary">@d.TotalKaryawan</td>
                                    <td class="text-center"><span class="badge bg-success">@d.TotalKaryawanTetap</span></td>
                                    <td class="text-center"><span class="badge bg-primary">@d.TotalKaryawanKontrak</span></td>
                                    <td class="text-center">@d.TotalLakiLaki</td>
                                    <td class="text-center">@d.TotalPerempuan</td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: @persen%"></div>
                                            </div>
                                            <span class="small fw-semibold text-dark">@persen%</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr class="table-light fw-bold">
                                <td colspan="2">TOTAL KESELURUHAN</td>
                                <td class="text-center text-primary">@Model.TotalSeluruhKaryawan</td>
                                <td class="text-center">@Model.RekapDepartemen.Sum(x => x.TotalKaryawanTetap)</td>
                                <td class="text-center">@Model.RekapDepartemen.Sum(x => x.TotalKaryawanKontrak)</td>
                                <td class="text-center">@Model.RekapDepartemen.Sum(x => x.TotalLakiLaki)</td>
                                <td class="text-center">@Model.RekapDepartemen.Sum(x => x.TotalPerempuan)</td>
                                <td class="text-end">100%</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    Belum ada data departemen yang terdaftar.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
