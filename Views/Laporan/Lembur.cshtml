@model SistemHRD.ViewModels.LaporanLemburViewModel
@{
    ViewData["Title"] = "Laporan Kerja Lembur";
    var tMulai = ViewBag.TanggalMulai as string ?? Model.TanggalMulai.ToString("yyyy-MM-dd");
    var tSelesai = ViewBag.TanggalSelesai as string ?? Model.TanggalSelesai.ToString("yyyy-MM-dd");
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Laporan</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lembur</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">Laporan Akumulasi Kerja Lembur</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Kembali
            </a>
            <button onclick="window.print()" class="btn btn-primary">
                <i data-lucide="printer" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Cetak
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Mulai</label>
                    <input type="date" name="tanggalMulai" value="@tMulai" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Tanggal Selesai</label>
                    <input type="date" name="tanggalSelesai" value="@tSelesai" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                        <option value="">Semua Departemen</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i data-lucide="filter" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                        Terapkan
                    </button>
                    <a asp-action="Lembur" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stat Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-primary p-3">
                <span class="text-muted small fw-semibold">TOTAL JAM LEMBUR DISETUJUI</span>
                <h3 class="fw-bold mb-0 text-primary">@Model.TotalJamLemburDisetujui.ToString("0.0") Jam</h3>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="card border-0 shadow-sm border-start border-4 border-success p-3">
                <span class="text-muted small fw-semibold">ESTIMASI BEBAN UANG LEMBUR</span>
                <h3 class="fw-bold mb-0 text-success">Rp @Model.TotalEstimasiUangLembur.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>TANGGAL</th>
                            <th>NIK & NAMA KARYAWAN</th>
                            <th>DEPARTEMEN</th>
                            <th>RENTANG WAKTU</th>
                            <th>DURASI</th>
                            <th>STATUS</th>
                            <th>ALASAN LEMBUR</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DataLembur.Any())
                        {
                            @foreach (var l in Model.DataLembur)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@l.Tanggal.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">@l.Tanggal.ToString("dddd")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@l.NamaKaryawan</div>
                                        <div class="text-muted small"><code>@l.NIK</code></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@l.NamaDepartemen</span>
                                    </td>
                                    <td>
                                        <span class="small text-dark">@l.JamMulai.ToString(@"hh\:mm") - @l.JamSelesai.ToString(@"hh\:mm")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@l.DurasiJam.ToString("0.0") Jam</span>
                                    </td>
                                    <td>
                                        @if (l.StatusPersetujuan == "Disetujui")
                                        {
                                            <span class="badge bg-success">Disetujui</span>
                                        }
                                        else if (l.StatusPersetujuan == "MenungguPersetujuan")
                                        {
                                            <span class="badge bg-warning text-dark">Menunggu Approval</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@l.StatusPersetujuan</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-muted" style="max-width:250px;">@l.AlasanLembur</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    Tidak ada catatan pengajuan lembur pada periode yang dipilih.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalHalaman > 1)
        {
            <div class="card-footer bg-white d-flex align-items-center justify-content-between py-3 border-top">
                <span class="small text-muted">
                    Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman
                </span>
                <nav aria-label="Navigasi Halaman">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= Model.TotalHalaman; i++)
                        {
                            <li class="page-item @(i == Model.HalamanSaatIni ? "active" : "")">
                                <a class="page-link" asp-action="Lembur"
                                   asp-route-halaman="@i"
                                   asp-route-tanggalMulai="@tMulai"
                                   asp-route-tanggalSelesai="@tSelesai"
                                   asp-route-departemenId="@Model.DepartemenIdTerpilih">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
