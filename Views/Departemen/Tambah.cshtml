@model SistemHRD.ViewModels.DepartemenFormViewModel
@{
    ViewData["Title"] = "Tambah Departemen";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-controller="Dasbor" asp-action="Index" class="text-decoration-none">Dasbor</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Departemen</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Tambah</li>
                    </ol>
                </nav>
                <h2 class="h4 fw-bold text-dark mb-0">Tambah Departemen Baru</h2>
                <p class="text-muted small mb-0">Lengkapi formulir berikut untuk mendaftarkan divisi / unit kerja baru.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Kembali
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form asp-action="Tambah" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="KodeDepartemen" class="form-label fw-semibold text-dark">
                                Kode Departemen <span class="text-danger">*</span>
                            </label>
                            <input asp-for="KodeDepartemen" class="form-control text-uppercase" placeholder="Contoh: IT, HRD, FIN" autofocus />
                            <span asp-validation-for="KodeDepartemen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="NamaDepartemen" class="form-label fw-semibold text-dark">
                                Nama Departemen <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NamaDepartemen" class="form-control" placeholder="Contoh: Teknologi Informasi & Sistem" />
                            <span asp-validation-for="NamaDepartemen" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Deskripsi" class="form-label fw-semibold text-dark">Deskripsi Departemen</label>
                            <textarea asp-for="Deskripsi" class="form-control" rows="3" placeholder="Deskripsikan fungsi dan lingkup kerja departemen..."></textarea>
                            <span asp-validation-for="Deskripsi" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="KepalaDepartemenId" class="form-label fw-semibold text-dark">Kepala Departemen (Manager)</label>
                            <select asp-for="KepalaDepartemenId" asp-items="Model.OpsiKaryawan" class="form-select">
                                <option value="">-- Pilih Kepala Departemen (Opsional) --</option>
                            </select>
                            <span asp-validation-for="KepalaDepartemenId" class="text-danger small"></span>
                            <small class="text-muted">Pilih karyawan yang ditunjuk sebagai penanggung jawab unit ini.</small>
                        </div>

                        <div class="col-md-4 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input asp-for="StatusAktif" class="form-check-input" type="checkbox" role="switch" id="switchStatusAktif" checked />
                                <label class="form-check-label fw-semibold text-dark ms-2" for="switchStatusAktif">
                                    Status Aktif
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Batal</a>
                        <button type="submit" class="btn btn-emerald px-4 d-inline-flex align-items-center gap-2">
                            <i data-lucide="check" style="width: 18px; height: 18px;"></i> Simpan Departemen
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();
    </script>
}
