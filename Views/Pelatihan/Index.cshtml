@model SistemHRD.ViewModels.DashboardPelatihanViewModel
@{
    ViewData["Title"] = "Pusat Pelatihan & Pengembangan Karyawan";
    var persenLulus = Model.TotalPesertaTerdaftar > 0
        ? Math.Round(((decimal)Model.TotalPesertaLulus / Model.TotalPesertaTerdaftar) * 100, 1)
        : 0;
}

<div class="container-fluid py-3">
    <!-- Header Page -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i data-lucide="graduation-cap" class="me-2 text-success" style="width:28px;height:28px;display:inline-block;vertical-align:bottom;"></i>
                Pusat Pelatihan & Pengembangan SDM
            </h4>
            <p class="text-muted small mb-0">Kelola kurikulum, pengembangan kompetensi, sertifikasi resmi, dan evaluasi hasil pelatihan karyawan.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Program" class="btn btn-outline-secondary">
                <i data-lucide="list" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                Daftar Program
            </a>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("HRD"))
            {
                <a asp-action="TambahProgram" class="btn btn-success text-white">
                    <i data-lucide="plus-circle" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
                    Program Baru
                </a>
            }
        </div>
    </div>

    <!-- Alert Notifikasi -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
            <i data-lucide="check-circle" class="me-2 text-success" style="width:20px;height:20px;"></i>
            <div>@TempData["PesanSukses"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
            <i data-lucide="alert-circle" class="me-2 text-danger" style="width:20px;height:20px;"></i>
            <div>@TempData["PesanError"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards Row -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">PROGRAM AKTIF</span>
                        <div class="bg-primary bg-opacity-10 p-2 rounded text-primary">
                            <i data-lucide="book-open" style="width:20px;height:20px;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">@Model.TotalProgramAktif</h3>
                    <div class="small text-muted">Sedang dibuka / berjalan</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">TOTAL PESERTA</span>
                        <div class="bg-success bg-opacity-10 p-2 rounded text-success">
                            <i data-lucide="users" style="width:20px;height:20px;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">@Model.TotalPesertaTerdaftar</h3>
                    <div class="small text-muted">Karyawan terdaftar pelatihan</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">KELULUSAN KOMPETENSI</span>
                        <div class="bg-info bg-opacity-10 p-2 rounded text-info">
                            <i data-lucide="award" style="width:20px;height:20px;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">@persenLulus%</h3>
                    <div class="small text-muted">@Model.TotalPesertaLulus peserta dinyatakan kompeten</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">SERTIFIKAT RESMI</span>
                        <div class="bg-warning bg-opacity-10 p-2 rounded text-warning">
                            <i data-lucide="file-check-2" style="width:20px;height:20px;"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark">@Model.TotalSertifikatTerbit</h3>
                    <div class="small text-muted">Diverifikasi sistem HRIS</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-3">
        <!-- Program Pelatihan Berlangsung & Terjadwal -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i data-lucide="calendar" class="me-2 text-primary" style="width:18px;height:18px;display:inline-block;vertical-align:text-bottom;"></i>
                        Program Pelatihan Terbaru & Berjalan
                    </h6>
                    <a asp-action="Program" class="btn btn-sm btn-link text-decoration-none">Lihat Semua &rarr;</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th>KODE & NAMA PROGRAM</th>
                                    <th>PENYELENGGARA</th>
                                    <th>JADWAL</th>
                                    <th>PESERTA</th>
                                    <th>STATUS</th>
                                    <th class="text-end">AKSI</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.ProgramTerbaru.Any())
                                {
                                    @foreach (var prog in Model.ProgramTerbaru)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@prog.NamaProgram</div>
                                                <div class="text-muted small"><code>@prog.KodeProgram</code> &bull; @prog.Metode</div>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold text-dark">@prog.Penyelenggara</div>
                                                <div class="text-muted small">@(prog.Instruktur ?? "-")</div>
                                            </td>
                                            <td>
                                                <div class="small text-dark">@prog.TanggalMulai.ToString("dd MMM yyyy")</div>
                                                <div class="text-muted small">s/d @prog.TanggalSelesai.ToString("dd MMM yyyy")</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@prog.JumlahPesertaTerdaftar / @(prog.MaksimalPeserta > 0 ? prog.MaksimalPeserta.ToString() : "&infin;")</span>
                                            </td>
                                            <td>
                                                @switch (prog.Status)
                                                {
                                                    case SistemHRD.Models.Enums.StatusPelatihan.Draf:
                                                        <span class="badge bg-light text-secondary border">Draf</span>
                                                        break;
                                                    case SistemHRD.Models.Enums.StatusPelatihan.PendaftaranDibuka:
                                                        <span class="badge bg-info text-dark">Pendaftaran Dibuka</span>
                                                        break;
                                                    case SistemHRD.Models.Enums.StatusPelatihan.Berlangsung:
                                                        <span class="badge bg-primary">Berlangsung</span>
                                                        break;
                                                    case SistemHRD.Models.Enums.StatusPelatihan.Selesai:
                                                        <span class="badge bg-success">Selesai</span>
                                                        break;
                                                    case SistemHRD.Models.Enums.StatusPelatihan.Dibatalkan:
                                                        <span class="badge bg-danger">Dibatalkan</span>
                                                        break;
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-action="DetailProgram" asp-route-id="@prog.Id" class="btn btn-sm btn-outline-primary">
                                                    Detail
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i data-lucide="inbox" class="d-block mx-auto mb-2 text-muted" style="width:36px;height:36px;"></i>
                                            Belum ada program pelatihan yang terjadwal.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side: Distribusi Status & Quick Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark">Rekapitulasi Pelatihan</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="small text-muted"><span class="badge bg-primary me-2">&bull;</span>Total Peserta Terdaftar</span>
                            <span class="fw-bold text-dark">@Model.TotalPesertaTerdaftar</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="small text-muted"><span class="badge bg-success me-2">&bull;</span>Peserta Lulus Kompeten</span>
                            <span class="fw-bold text-success">@Model.TotalPesertaLulus</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0">
                            <span class="small text-muted"><span class="badge bg-warning me-2">&bull;</span>Sertifikat Terbit</span>
                            <span class="fw-bold text-warning">@Model.TotalSertifikatTerbit</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-dark mb-2">Menu Cepat Pelatihan</h6>
                    <div class="d-grid gap-2">
                        <a asp-action="Program" class="btn btn-white border text-start d-flex align-items-center justify-content-between">
                            <span><i data-lucide="layers" class="me-2 text-primary" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Semua Program Pelatihan</span>
                            <i data-lucide="chevron-right" style="width:16px;height:16px;"></i>
                        </a>
                        <a asp-controller="Laporan" asp-action="Pelatihan" class="btn btn-white border text-start d-flex align-items-center justify-content-between">
                            <span><i data-lucide="bar-chart-2" class="me-2 text-success" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Laporan & Analitik Pelatihan</span>
                            <i data-lucide="chevron-right" style="width:16px;height:16px;"></i>
                        </a>
                        <a asp-action="RiwayatSaya" class="btn btn-white border text-start d-flex align-items-center justify-content-between">
                            <span><i data-lucide="user-check" class="me-2 text-warning" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i> Riwayat Pelatihan Pribadi (ESS)</span>
                            <i data-lucide="chevron-right" style="width:16px;height:16px;"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
