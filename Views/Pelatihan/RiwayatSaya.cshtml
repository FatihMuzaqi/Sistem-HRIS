@model List<SistemHRD.ViewModels.PesertaPelatihanItemViewModel>
@{
    ViewData["Title"] = "Riwayat Pelatihan Saya";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i data-lucide="award" class="me-2 text-success" style="width:26px;height:26px;display:inline-block;vertical-align:bottom;"></i>
                Riwayat Pelatihan & Sertifikasi Saya
            </h4>
            <p class="text-muted small mb-0">Daftar keikutsertaan pelatihan, penilaian kelulusan, dan unduh sertifikat resmi kompetensi Anda.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i data-lucide="arrow-left" class="me-1" style="width:16px;height:16px;display:inline-block;vertical-align:text-bottom;"></i>
            Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th>PROGRAM PELATIHAN</th>
                            <th>STATUS KEIKUTSERTAAN</th>
                            <th>NILAI EVALUASI</th>
                            <th>CATATAN EVALUATOR</th>
                            <th>TANGGAL TERDAFTAR</th>
                            <th class="text-end">SERTIFIKAT</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@r.NamaProgram</div>
                                        <div class="text-muted small">Terdaftar sebagai peserta</div>
                                    </td>
                                    <td>
                                        @switch (r.Status)
                                        {
                                            case SistemHRD.Models.Enums.StatusKeikutsertaan.Terdaftar:
                                                <span class="badge bg-secondary">Terdaftar</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKeikutsertaan.SedangMengikuti:
                                                <span class="badge bg-primary">Sedang Mengikuti</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKeikutsertaan.Lulus:
                                                <span class="badge bg-success">Lulus Kompeten</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKeikutsertaan.TidakLulus:
                                                <span class="badge bg-danger">Tidak Lulus</span>
                                                break;
                                            case SistemHRD.Models.Enums.StatusKeikutsertaan.Batal:
                                                <span class="badge bg-dark">Batal</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (r.NilaiAkhir.HasValue)
                                        {
                                            <span class="fw-bold @(r.NilaiAkhir >= 70 ? "text-success" : "text-danger")">@r.NilaiAkhir.Value.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="small text-muted">@(string.IsNullOrWhiteSpace(r.Catatan) ? "-" : r.Catatan)</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@r.TanggalDidaftarkan.ToString("dd MMM yyyy")</span>
                                    </td>
                                    <td class="text-end">
                                        @if (r.SertifikatId.HasValue)
                                        {
                                            <a asp-action="Sertifikat" asp-route-id="@r.SertifikatId.Value" target="_blank" class="btn btn-sm btn-success text-white">
                                                <i data-lucide="download" class="me-1" style="width:14px;height:14px;display:inline-block;vertical-align:text-bottom;"></i>
                                                Lihat Sertifikat
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">Belum Terbit</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i data-lucide="award" class="d-block mx-auto mb-2 text-muted" style="width:40px;height:40px;"></i>
                                    Anda belum memiliki riwayat keikutsertaan program pelatihan.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
