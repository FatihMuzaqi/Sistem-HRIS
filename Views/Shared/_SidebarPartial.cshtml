@using SistemHRD.Common.Constants

<aside class="app-sidebar" id="appSidebar">
    <!-- Header Sidebar -->
    <div class="sidebar-header">
        <a asp-controller="Dasbor" asp-action="Index" class="sidebar-brand">
            <div class="brand-icon">
                <i data-lucide="shield-check" style="width: 22px; height: 22px;"></i>
            </div>
            <div>
                <span style="color: var(--primary-emerald);">Sistem</span><span style="color: #0f172a;">HRD</span>
            </div>
        </a>
    </div>

    <!-- Menu Navigasi -->
    <div class="sidebar-menu">
        <div class="menu-category">Menu Utama</div>
        <a asp-controller="Dasbor" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dasbor" ? "active" : "")">
            <i data-lucide="layout-dashboard"></i>
            <span>Dasbor</span>
        </a>

        @if (User.IsInRole(NamaPeran.SuperAdmin))
        {
            <div class="menu-category">Platform SuperAdmin</div>
            <a href="#" class="nav-link-item">
                <i data-lucide="building-2"></i>
                <span>Kelola Perusahaan</span>
            </a>
            <a href="#" class="nav-link-item">
                <i data-lucide="users-2"></i>
                <span>Kelola Pengguna</span>
            </a>
            <a href="#" class="nav-link-item">
                <i data-lucide="file-clock"></i>
                <span>Log Audit Platform</span>
            </a>
            <a href="#" class="nav-link-item">
                <i data-lucide="settings"></i>
                <span>Pengaturan Sistem</span>
            </a>
        }

        @if (User.IsInRole(NamaPeran.HRD) || User.IsInRole(NamaPeran.SuperAdmin))
        {
            <div class="menu-category">Manajemen SDM (HRD)</div>
            <a asp-controller="Karyawan" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Karyawan" ? "active" : "")">
                <i data-lucide="users"></i>
                <span>Data Karyawan</span>
            </a>
            <a asp-controller="Departemen" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departemen" ? "active" : "")">
                <i data-lucide="network"></i>
                <span>Departemen</span>
            </a>
            <a asp-controller="Jabatan" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jabatan" ? "active" : "")">
                <i data-lucide="briefcase"></i>
                <span>Jabatan</span>
            </a>
            <a asp-controller="Kehadiran" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kehadiran" && ViewContext.RouteData.Values["action"]?.ToString() != "Presensi" ? "active" : "")">
                <i data-lucide="calendar-check"></i>
                <span>Kehadiran & Presensi</span>
            </a>
            <a asp-controller="Cuti" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cuti" && ViewContext.RouteData.Values["action"]?.ToString() != "Pengajuan" ? "active" : "")">
                <i data-lucide="plane"></i>
                <span>Manajemen Cuti</span>
            </a>
            <a asp-controller="Penggajian" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Penggajian" && ViewContext.RouteData.Values["action"]?.ToString() != "Riwayat" ? "active" : "")">
                <i data-lucide="banknote"></i>
                <span>Penggajian (Payroll)</span>
            </a>
            <a asp-controller="Rekrutmen" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rekrutmen" ? "active" : "")">
                <i data-lucide="user-plus"></i>
                <span>Rekrutmen & Pelamar</span>
            </a>
            <a asp-controller="Kinerja" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kinerja" && ViewContext.RouteData.Values["action"]?.ToString() != "RiwayatSaya" ? "active" : "")">
                <i data-lucide="award"></i>
                <span>Penilaian Kinerja</span>
            </a>
        }

        @if (User.IsInRole(NamaPeran.Manager) && !User.IsInRole(NamaPeran.SuperAdmin) && !User.IsInRole(NamaPeran.HRD))
        {
            <div class="menu-category">Manajemen Tim</div>
            <a asp-controller="Kehadiran" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kehadiran" ? "active" : "")">
                <i data-lucide="calendar-check"></i>
                <span>Kehadiran Tim</span>
            </a>
            <a asp-controller="Cuti" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cuti" ? "active" : "")">
                <i data-lucide="check-square"></i>
                <span>Persetujuan Cuti/Lembur</span>
            </a>
            <a asp-controller="Kinerja" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kinerja" && ViewContext.RouteData.Values["action"]?.ToString() != "RiwayatSaya" ? "active" : "")">
                <i data-lucide="trending-up"></i>
                <span>Evaluasi Kinerja Tim</span>
            </a>
            <a asp-controller="Rekrutmen" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rekrutmen" ? "active" : "")">
                <i data-lucide="user-plus"></i>
                <span>Wawancara & Pelamar</span>
            </a>
        }

        @if (User.IsInRole(NamaPeran.Finance) && !User.IsInRole(NamaPeran.SuperAdmin))
        {
            <div class="menu-category">Keuangan</div>
            <a asp-controller="Kehadiran" asp-action="Rekap" class="nav-link-item">
                <i data-lucide="file-spreadsheet"></i>
                <span>Rekap Absensi Payroll</span>
            </a>
            <a asp-controller="Penggajian" asp-action="Index" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Penggajian" && ViewContext.RouteData.Values["action"]?.ToString() != "Riwayat" ? "active" : "")">
                <i data-lucide="wallet"></i>
                <span>Penggajian (Payroll)</span>
            </a>
        }

        <div class="menu-category">Employee Self Service</div>
        <a asp-controller="Kehadiran" asp-action="Presensi" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kehadiran" && ViewContext.RouteData.Values["action"]?.ToString() == "Presensi" ? "active" : "")">
            <i data-lucide="clock"></i>
            <span>Presensi Harian</span>
        </a>
        <a asp-controller="Cuti" asp-action="Pengajuan" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cuti" && ViewContext.RouteData.Values["action"]?.ToString() == "Pengajuan" ? "active" : "")">
            <i data-lucide="send"></i>
            <span>Pengajuan Cuti</span>
        </a>
        <a asp-controller="Penggajian" asp-action="Riwayat" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Penggajian" && ViewContext.RouteData.Values["action"]?.ToString() == "Riwayat" ? "active" : "")">
            <i data-lucide="receipt"></i>
            <span>Slip Gaji Saya</span>
        </a>
        <a asp-controller="Kinerja" asp-action="RiwayatSaya" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Kinerja" && ViewContext.RouteData.Values["action"]?.ToString() == "RiwayatSaya" ? "active" : "")">
            <i data-lucide="award"></i>
            <span>Evaluasi Kinerja Saya</span>
        </a>

        <div class="menu-category">Akun</div>
        <a asp-controller="Pengguna" asp-action="Profil" class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pengguna" ? "active" : "")">
            <i data-lucide="user"></i>
            <span>Profil Pengguna</span>
        </a>
    </div>
</aside>
