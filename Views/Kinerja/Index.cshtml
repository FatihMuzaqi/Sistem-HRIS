@model SistemHRD.ViewModels.DashboardKinerjaViewModel
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Dashboard Penilaian Kinerja (KPI)";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-4 text-white d-flex align-items-center justify-content-center" style="background-color: #059669; width: 56px; height: 56px;">
                        <i data-lucide="award" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Manajemen Penilaian Kinerja</h4>
                        <p class="text-muted small mb-0">Evaluasi performa berbasis indikator KPI terukur, transparan, dan objektif</p>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a asp-action="InputPenilaian" class="btn text-white rounded-3 px-3" style="background-color: #059669;">
                        <i data-lucide="plus-circle" class="lucide me-1"></i> Input Penilaian Karyawan
                    </a>
                    <a asp-action="Penilaian" class="btn btn-outline-secondary rounded-3">
                        <i data-lucide="list-checks" class="lucide me-1"></i> Daftar Evaluasi
                    </a>
                    <a asp-action="Periode" class="btn btn-outline-secondary rounded-3">
                        <i data-lucide="calendar" class="lucide me-1"></i> Periode
                    </a>
                    <a asp-action="Indikator" class="btn btn-outline-secondary rounded-3">
                        <i data-lucide="target" class="lucide me-1"></i> Indikator KPI
                    </a>
                    <a asp-action="Laporan" class="btn btn-outline-primary rounded-3">
                        <i data-lucide="bar-chart-2" class="lucide me-1"></i> Laporan Performa
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="check-circle" class="lucide text-success"></i>
                <span>@TempData["PesanSukses"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="alert-circle" class="lucide text-danger"></i>
                <span>@TempData["PesanError"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stat Metrik -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Periode Aktif</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalPeriodeAktif</h3>
                        <small class="text-success fw-medium">Siklus Evaluasi Berjalan</small>
                    </div>
                    <div class="p-3 rounded-4 bg-primary-subtle text-primary">
                        <i data-lucide="calendar-check" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Karyawan Dinilai</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalKaryawanTelahDinilai</h3>
                        <small class="text-muted">Total Lembar Selesai</small>
                    </div>
                    <div class="p-3 rounded-4 bg-info-subtle text-info">
                        <i data-lucide="users" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Rata-Rata Skor</span>
                        <h3 class="fw-bold mb-0 text-success">@Model.RataRataSkorPerusahaan.ToString("F1")</h3>
                        <small class="text-muted">Skala 0 - 100</small>
                    </div>
                    <div class="p-3 rounded-4 bg-success-subtle text-success">
                        <i data-lucide="trending-up" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Indikator KPI Aktif</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalIndikatorKPIAktif</h3>
                        <small class="text-muted">Kuantitatif & Kualitatif</small>
                    </div>
                    <div class="p-3 rounded-4 bg-warning-subtle text-warning">
                        <i data-lucide="target" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-4">
        <!-- Distribusi Predikat Kinerja -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">Distribusi Predikat Kinerja</h6>
                    <small class="text-muted">Kategori A s/d E</small>
                </div>
                <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="chartPredikatKinerja"></canvas>
                    </div>
                    <div class="mt-3 d-flex flex-wrap justify-content-center gap-2 small text-muted">
                        <span><strong class="text-success">A:</strong> Sangat Baik (≥90)</span> &bull;
                        <span><strong class="text-primary">B:</strong> Baik (≥80)</span> &bull;
                        <span><strong class="text-info">C:</strong> Cukup (≥70)</span> &bull;
                        <span><strong class="text-warning">D:</strong> Kurang (≥60)</span> &bull;
                        <span><strong class="text-danger">E:</strong> Sangat Kurang (&lt;60)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rata-Rata Skor per Departemen -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">Rata-Rata Skor per Departemen</h6>
                    <small class="text-muted">Performa Tim</small>
                </div>
                <div class="card-body p-4">
                    <div style="position: relative; height: 280px; width: 100%;">
                        <canvas id="chartSkorDepartemen"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabel Penilaian Terbaru -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold text-dark mb-0">Evaluasi Kinerja Terbaru</h6>
                <small class="text-muted">Daftar penilaian karyawan yang baru saja diselesaikan</small>
            </div>
            <a asp-action="Penilaian" class="btn btn-sm btn-outline-secondary rounded-3">Lihat Semua</a>
        </div>
        <div class="card-body p-4">
            @if (!Model.PenilaianTerbaru.Any())
            {
                <div class="text-center py-5">
                    <i data-lucide="clipboard-x" class="lucide text-muted mb-2" style="width: 48px; height: 48px;"></i>
                    <h6 class="fw-semibold text-dark">Belum Ada Riwayat Penilaian</h6>
                    <p class="text-muted small">Mulai lakukan evaluasi kinerja karyawan dengan mengklik tombol "Input Penilaian Karyawan" di atas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Karyawan</th>
                                <th>Departemen & Jabatan</th>
                                <th>Periode</th>
                                <th>Penilai</th>
                                <th>Tanggal</th>
                                <th class="text-center">Skor Akhir</th>
                                <th class="text-center">Predikat</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PenilaianTerbaru)
                            {
                                string predikatBadge = item.PredikatKinerja switch
                                {
                                    KategoriKinerja.Istimewa => "bg-success text-white",
                                    KategoriKinerja.Baik => "bg-primary text-white",
                                    KategoriKinerja.Cukup => "bg-info text-dark",
                                    KategoriKinerja.Kurang => "bg-warning text-dark",
                                    KategoriKinerja.SangatKurang => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.NamaKaryawan</div>
                                        <small class="text-muted">NIK: @item.NIK</small>
                                    </td>
                                    <td>
                                        <div class="text-dark">@item.NamaDepartemen</div>
                                        <small class="text-muted">@item.NamaJabatan</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.NamaPeriode</span>
                                    </td>
                                    <td>
                                        <small class="text-dark fw-medium">@item.NamaPenilai</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.TanggalPenilaian.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold fs-6 text-dark">@item.TotalSkorAkhir.ToString("F1")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @predikatBadge rounded-pill px-3 py-1">@item.PredikatKinerja</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="DetailPenilaian" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                            <i data-lucide="eye" class="lucide me-1" style="width: 14px; height: 14px;"></i> Lembar Evaluasi
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        lucide.createIcons();

        // 1. Chart Distribusi Predikat Kinerja (Doughnut)
        var predikatLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistribusiPredikatKinerja.Keys));
        var predikatData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistribusiPredikatKinerja.Values));

        var ctxPredikat = document.getElementById('chartPredikatKinerja').getContext('2d');
        new Chart(ctxPredikat, {
            type: 'doughnut',
            data: {
                labels: predikatLabels,
                datasets: [{
                    data: predikatData,
                    backgroundColor: [
                        '#059669', // SangatBaik (Emerald)
                        '#2563eb', // Baik (Blue)
                        '#0284c7', // Cukup (Cyan/Sky)
                        '#f59e0b', // Kurang (Amber)
                        '#ef4444'  // SangatKurang (Red)
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                },
                cutout: '65%'
            }
        });

        // 2. Chart Rata-Rata Skor per Departemen (Bar)
        var deptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RataRataSkorPerDepartemen.Keys));
        var deptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RataRataSkorPerDepartemen.Values));

        var ctxDept = document.getElementById('chartSkorDepartemen').getContext('2d');
        new Chart(ctxDept, {
            type: 'bar',
            data: {
                labels: deptLabels,
                datasets: [{
                    label: 'Rata-Rata Skor KPI',
                    data: deptData,
                    backgroundColor: '#059669',
                    borderRadius: 8,
                    maxBarThickness: 45
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            stepSize: 20
                        }
                    }
                },
                plugins: {
                    legend: {
                        display: false
                    }
                }
            }
        });
    </script>
}
