@model List<SistemHRD.ViewModels.PeriodePenilaianItemViewModel>
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Kelola Periode Penilaian Kinerja";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i data-lucide="arrow-left" class="lucide me-1"></i> Dashboard Kinerja
                    </a>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Periode Penilaian Kinerja</h4>
                        <p class="text-muted small mb-0">Atur siklus penilaian kinerja berkala (Semesteran, Tahunan, atau Kuartalan)</p>
                    </div>
                </div>

                @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
                {
                    <a asp-action="TambahPeriode" class="btn text-white rounded-3 px-3" style="background-color: #059669;">
                        <i data-lucide="plus-circle" class="lucide me-1"></i> Buat Periode Baru
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="check-circle" class="lucide text-success"></i>
                <span>@TempData["PesanSukses"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="alert-circle" class="lucide text-danger"></i>
                <span>@TempData["PesanError"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Periode -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i data-lucide="calendar-x" class="lucide text-muted mb-2" style="width: 48px; height: 48px;"></i>
                    <h6 class="fw-semibold text-dark">Belum Ada Periode Penilaian</h6>
                    <p class="text-muted small">Buat periode penilaian kinerja pertama Anda dengan tombol "Buat Periode Baru" di atas.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nama Periode</th>
                                <th>Tahun & Siklus</th>
                                <th>Rentang Waktu</th>
                                <th class="text-center">Status</th>
                                <th class="text-center">Karyawan Dinilai</th>
                                <th class="text-center">Rata-Rata Skor</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                string statusBadge = p.Status switch
                                {
                                    StatusPeriodePenilaian.Aktif => "bg-success text-white",
                                    StatusPeriodePenilaian.PenilaianSelesai => "bg-secondary text-white",
                                    StatusPeriodePenilaian.Draf => "bg-warning text-dark",
                                    StatusPeriodePenilaian.Ditutup => "bg-danger text-white",
                                    _ => "bg-light text-dark"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@p.NamaPeriode</div>
                                        <small class="text-muted">@(string.IsNullOrWhiteSpace(p.Catatan) ? "-" : p.Catatan)</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">Tahun @p.Tahun</div>
                                        <small class="text-muted">@(p.SemesterAtauKuartal ?? "Tahunan")</small>
                                    </td>
                                    <td>
                                        <div class="text-dark">@p.TanggalMulai.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">s/d @p.TanggalSelesai.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @statusBadge rounded-pill px-3 py-1">@p.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold text-dark fs-6">@p.TotalKaryawanDinilai</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold text-success fs-6">@p.RataRataSkor.ToString("F1")</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Penilaian" asp-route-periodeId="@p.Id" class="btn btn-sm btn-outline-primary rounded-start-3" title="Lihat Evaluasi">
                                                <i data-lucide="list" class="lucide" style="width: 14px; height: 14px;"></i>
                                            </a>
                                            @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
                                            {
                                                <a asp-action="UbahPeriode" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Edit Periode">
                                                    <i data-lucide="edit-3" class="lucide" style="width: 14px; height: 14px;"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-end-3" data-bs-toggle="modal" data-bs-target="#modalHapusPeriode-@p.Id" title="Hapus Periode">
                                                    <i data-lucide="trash-2" class="lucide" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            }
                                        </div>

                                        <!-- Modal Hapus -->
                                        @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
                                        {
                                            <div class="modal fade" id="modalHapusPeriode-@p.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content rounded-4 border-0 text-start">
                                                        <form asp-action="HapusPeriode" asp-route-id="@p.Id" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title fw-bold text-danger">Konfirmasi Hapus Periode</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="text-muted">Apakah Anda yakin ingin menghapus periode penilaian <strong>@p.NamaPeriode</strong>?</p>
                                                                <small class="text-danger d-block">Catatan: Periode yang sudah memiliki lembar penilaian tidak dapat dihapus.</small>
                                                            </div>
                                                            <div class="modal-footer border-0 pt-0">
                                                                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Batal</button>
                                                                <button type="submit" class="btn btn-danger rounded-3">Hapus Periode</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
