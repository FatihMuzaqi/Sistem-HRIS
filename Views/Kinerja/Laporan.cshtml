@model SistemHRD.ViewModels.LaporanPerformaKaryawanViewModel
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Laporan Performa Kinerja Karyawan";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white d-print-none">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i data-lucide="arrow-left" class="lucide me-1"></i> Dashboard Kinerja
                    </a>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Laporan Performa Kinerja Karyawan</h4>
                        <p class="text-muted small mb-0">Analitik dan rekapitulasi penilaian kinerja berdasarkan departemen dan periode</p>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" onclick="window.print()" class="btn btn-outline-secondary rounded-3 px-3">
                        <i data-lucide="printer" class="lucide me-1"></i> Cetak Laporan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white d-print-none">
        <div class="card-body p-4">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Departemen</label>
                    <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select rounded-3">
                        <option value="">-- Semua Departemen --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Karyawan Tertentu</label>
                    <select name="karyawanId" asp-items="ViewBag.DaftarKaryawan" class="form-select rounded-3">
                        <option value="">-- Semua Karyawan --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Tahun Evaluasi</label>
                    <input name="tahun" type="number" value="@ViewBag.TahunTerpilih" class="form-control rounded-3" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn text-white w-100 rounded-3" style="background-color: #059669;">
                        <i data-lucide="search" class="lucide me-1"></i> Tampilkan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrik -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Total Lembar Penilaian</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalPenilaian</h3>
                        <small class="text-muted">Hasil filter yang ditampilkan</small>
                    </div>
                    <div class="p-3 rounded-4 bg-primary-subtle text-primary">
                        <i data-lucide="clipboard-check" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold d-block mb-1">Rata-Rata Skor Keseluruhan</span>
                        <h3 class="fw-bold mb-0 text-success">@Model.RataRataSkorTotal.ToString("F2")</h3>
                        <small class="text-muted">Skala 0 s/d 100</small>
                    </div>
                    <div class="p-3 rounded-4 bg-success-subtle text-success">
                        <i data-lucide="award" class="lucide" style="width: 28px; height: 28px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Laporan -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4">
            @if (!Model.DaftarPenilaian.Any())
            {
                <div class="text-center py-5">
                    <i data-lucide="folder-x" class="lucide text-muted mb-2" style="width: 48px; height: 48px;"></i>
                    <h6 class="fw-semibold text-dark">Tidak Ada Data Penilaian Kinerja</h6>
                    <p class="text-muted small">Coba ubah filter departemen, karyawan, atau tahun untuk melihat hasil lainnya.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Karyawan</th>
                                <th>Departemen</th>
                                <th>Jabatan</th>
                                <th>Periode Evaluasi</th>
                                <th>Atasan Penilai</th>
                                <th>Tanggal</th>
                                <th class="text-center">Skor Akhir</th>
                                <th class="text-center">Predikat</th>
                                <th class="text-end d-print-none">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.DaftarPenilaian)
                            {
                                string predikatBadge = row.PredikatKinerja switch
                                {
                                    KategoriKinerja.Istimewa => "bg-success text-white",
                                    KategoriKinerja.Baik => "bg-primary text-white",
                                    KategoriKinerja.Cukup => "bg-info text-dark",
                                    KategoriKinerja.Kurang => "bg-warning text-dark",
                                    KategoriKinerja.SangatKurang => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@row.NamaKaryawan</div>
                                        <small class="text-muted">NIK: @row.NIK</small>
                                    </td>
                                    <td>@row.NamaDepartemen</td>
                                    <td>@row.NamaJabatan</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@row.NamaPeriode</span>
                                    </td>
                                    <td>@row.NamaPenilai</td>
                                    <td>@row.TanggalPenilaian.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="fw-bold fs-6 text-dark">@row.TotalSkorAkhir.ToString("F1")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @predikatBadge rounded-pill px-3 py-1">@row.PredikatKinerja</span>
                                    </td>
                                    <td class="text-end d-print-none">
                                        <a asp-action="DetailPenilaian" asp-route-id="@row.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                            <i data-lucide="eye" class="lucide me-1" style="width: 14px; height: 14px;"></i> Lihat
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
