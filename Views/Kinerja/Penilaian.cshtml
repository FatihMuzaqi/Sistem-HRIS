@model List<SistemHRD.ViewModels.PenilaianKinerjaItemViewModel>
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Daftar Evaluasi Kinerja Karyawan";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i data-lucide="arrow-left" class="lucide me-1"></i> Dashboard Kinerja
                    </a>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Daftar Evaluasi Kinerja Karyawan</h4>
                        <p class="text-muted small mb-0">Arsip dan riwayat penilaian performa KPI seluruh karyawan</p>
                    </div>
                </div>

                <a asp-action="InputPenilaian" class="btn text-white rounded-3 px-3" style="background-color: #059669;">
                    <i data-lucide="plus-circle" class="lucide me-1"></i> Input Penilaian Karyawan
                </a>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="check-circle" class="lucide text-success"></i>
                <span>@TempData["PesanSukses"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="alert-circle" class="lucide text-danger"></i>
                <span>@TempData["PesanError"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Filter Periode Penilaian</label>
                    <select name="periodeId" asp-items="ViewBag.DaftarPeriode" class="form-select rounded-3" onchange="this.form.submit()">
                        <option value="">-- Semua Periode Penilaian --</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small text-muted mb-1">Filter Karyawan</label>
                    <select name="karyawanId" asp-items="ViewBag.DaftarKaryawan" class="form-select rounded-3" onchange="this.form.submit()">
                        <option value="">-- Semua Karyawan --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <a asp-action="Penilaian" class="btn btn-outline-secondary w-100 rounded-3">Reset Filter</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Evaluasi -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i data-lucide="clipboard-x" class="lucide text-muted mb-2" style="width: 48px; height: 48px;"></i>
                    <h6 class="fw-semibold text-dark">Tidak Ada Data Penilaian</h6>
                    <p class="text-muted small">Belum ada evaluasi kinerja yang sesuai dengan filter pencarian.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Karyawan</th>
                                <th>Departemen & Jabatan</th>
                                <th>Periode</th>
                                <th>Penilai</th>
                                <th>Tanggal</th>
                                <th class="text-center">Skor Akhir</th>
                                <th class="text-center">Predikat</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string predikatBadge = item.PredikatKinerja switch
                                {
                                    KategoriKinerja.SangatBaik => "bg-success text-white",
                                    KategoriKinerja.Baik => "bg-primary text-white",
                                    KategoriKinerja.Cukup => "bg-info text-dark",
                                    KategoriKinerja.Kurang => "bg-warning text-dark",
                                    KategoriKinerja.SangatKurang => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                string statusBadge = item.Status switch
                                {
                                    StatusPenilaianKinerja.Disetujui => "bg-success-subtle text-success-emphasis",
                                    StatusPenilaianKinerja.Draf => "bg-warning-subtle text-warning-emphasis",
                                    StatusPenilaianKinerja.Ditolak => "bg-danger-subtle text-danger-emphasis",
                                    _ => "bg-light text-muted"
                                };

                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@item.NamaKaryawan</div>
                                        <small class="text-muted">NIK: @item.NIK</small>
                                    </td>
                                    <td>
                                        <div class="text-dark">@item.NamaDepartemen</div>
                                        <small class="text-muted">@item.NamaJabatan</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.NamaPeriode</span>
                                    </td>
                                    <td>
                                        <small class="text-dark fw-medium">@item.NamaPenilai</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.TanggalPenilaian.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold fs-6 text-dark">@item.TotalSkorAkhir.ToString("F1")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @predikatBadge rounded-pill px-3 py-1">@item.PredikatKinerja</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @statusBadge rounded-pill px-3 py-1">@item.Status</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="DetailPenilaian" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-3">
                                            <i data-lucide="file-text" class="lucide me-1" style="width: 14px; height: 14px;"></i> Lembar Evaluasi
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
