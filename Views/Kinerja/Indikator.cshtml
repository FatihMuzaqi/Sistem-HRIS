@model List<SistemHRD.ViewModels.IndikatorKPIItemViewModel>
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Master Indikator KPI";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3">
                        <i data-lucide="arrow-left" class="lucide me-1"></i> Dashboard Kinerja
                    </a>
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Master Indikator KPI</h4>
                        <p class="text-muted small mb-0">Kelola tolak ukur dan metrik evaluasi kinerja objektif per departemen/jabatan</p>
                    </div>
                </div>

                @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
                {
                    <a asp-action="TambahIndikator" class="btn text-white rounded-3 px-3" style="background-color: #059669;">
                        <i data-lucide="plus-circle" class="lucide me-1"></i> Tambah Indikator KPI
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["PesanSukses"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="check-circle" class="lucide text-success"></i>
                <span>@TempData["PesanSukses"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["PesanError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i data-lucide="alert-circle" class="lucide text-danger"></i>
                <span>@TempData["PesanError"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i data-lucide="filter" class="lucide text-muted" style="width: 16px; height: 16px;"></i>
                        </span>
                        <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select border-start-0" onchange="this.form.submit()">
                            <option value="">-- Semua Departemen --</option>
                        </select>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Indikator" class="btn btn-outline-secondary rounded-3">Reset Filter</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table Indikator KPI -->
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i data-lucide="target" class="lucide text-muted mb-2" style="width: 48px; height: 48px;"></i>
                    <h6 class="fw-semibold text-dark">Belum Ada Indikator KPI</h6>
                    <p class="text-muted small">Buat indikator kinerja baru untuk dijadikan tolok ukur penilaian karyawan.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kode & Nama Indikator</th>
                                <th>Departemen / Jabatan</th>
                                <th>Tipe</th>
                                <th>Target & Satuan</th>
                                <th class="text-center">Bobot Default</th>
                                <th class="text-center">Status</th>
                                <th class="text-end">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var k in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border font-monospace">@k.KodeIndikator</span>
                                            <span class="fw-bold text-dark">@k.NamaIndikator</span>
                                        </div>
                                        <small class="text-muted d-block mt-1">@(string.IsNullOrWhiteSpace(k.Deskripsi) ? "-" : k.Deskripsi)</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@k.NamaDepartemen</div>
                                        <small class="text-muted">@k.NamaJabatan</small>
                                    </td>
                                    <td>
                                        <span class="badge @(k.Jenis == JenisIndikatorKPI.Kuantitatif ? "bg-info-subtle text-info-emphasis" : "bg-warning-subtle text-warning-emphasis") rounded-pill px-3">
                                            @k.Jenis
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@(k.TargetKuantitatif.HasValue ? k.TargetKuantitatif.Value.ToString("G29") : "-")</span>
                                        <span class="text-muted small">@(k.Satuan ?? "")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold text-success fs-6">@k.BobotBawaan.ToString("G29")%</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(k.StatusAktif ? "bg-success-subtle text-success-emphasis" : "bg-light text-muted") rounded-pill px-3">
                                            @(k.StatusAktif ? "Aktif" : "Nonaktif")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
                                        {
                                            <div class="btn-group">
                                                <a asp-action="UbahIndikator" asp-route-id="@k.Id" class="btn btn-sm btn-outline-secondary rounded-start-3" title="Edit Indikator">
                                                    <i data-lucide="edit-3" class="lucide" style="width: 14px; height: 14px;"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-end-3" data-bs-toggle="modal" data-bs-target="#modalHapusIndikator-@k.Id" title="Hapus Indikator">
                                                    <i data-lucide="trash-2" class="lucide" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            </div>

                                            <!-- Modal Hapus -->
                                            <div class="modal fade" id="modalHapusIndikator-@k.Id" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content rounded-4 border-0 text-start">
                                                        <form asp-action="HapusIndikator" asp-route-id="@k.Id" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <div class="modal-header border-0 pb-0">
                                                                <h5 class="modal-title fw-bold text-danger">Konfirmasi Hapus Indikator KPI</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <p class="text-muted">Apakah Anda yakin ingin menghapus indikator <strong>@k.KodeIndikator - @k.NamaIndikator</strong>?</p>
                                                                <small class="text-danger d-block">Catatan: Indikator yang telah digunakan pada lembar penilaian karyawan tidak dapat dihapus.</small>
                                                            </div>
                                                            <div class="modal-footer border-0 pt-0">
                                                                <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Batal</button>
                                                                <button type="submit" class="btn btn-danger rounded-3">Hapus Indikator</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
