@model SistemHRD.ViewModels.KaryawanFormViewModel
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Ubah Karyawan";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-controller="Dasbor" asp-action="Index" class="text-decoration-none">Dasbor</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Karyawan</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Ubah</li>
                    </ol>
                </nav>
                <h2 class="h4 fw-bold text-dark mb-0">Ubah Data Karyawan</h2>
                <p class="text-muted small mb-0">Perbarui informasi kepegawaian @Model.NamaLengkap (@Model.NomorIndukKaryawan).</p>
            </div>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Kembali ke Detail
            </a>
        </div>

        <form asp-action="Ubah" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FotoProfilSaatIni" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

            <div class="row g-4">
                <!-- Kolom Kiri: Foto Profil & Info Utama -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-3 text-center p-4">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.FotoProfilSaatIni))
                            {
                                <img id="previewFoto" src="/@Model.FotoProfilSaatIni" alt="@Model.NamaLengkap" class="rounded-circle img-thumbnail shadow-sm object-fit-cover" style="width: 140px; height: 140px;" />
                            }
                            else
                            {
                                <img id="previewFoto" src="/images/avatar-default.png" onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.NamaLengkap)&background=ecfdf5&color=059669&size=160';" alt="Preview Foto" class="rounded-circle img-thumbnail shadow-sm object-fit-cover" style="width: 140px; height: 140px;" />
                            }
                        </div>
                        <h6 class="fw-semibold text-dark mb-1">Ganti Foto Profil</h6>
                        <p class="text-muted small mb-3">Format JPG/PNG, ukuran maksimal 2MB.</p>
                        <div>
                            <input asp-for="BerkasFoto" type="file" class="form-control form-control-sm" id="inputFoto" accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="BerkasFoto" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-3 mt-4 p-4">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i data-lucide="briefcase" style="width: 18px; height: 18px;" class="text-emerald"></i>
                            Status Kepegawaian
                        </h6>

                        <div class="mb-3">
                            <label asp-for="StatusKaryawan" class="form-label fw-semibold text-dark">Status Karyawan <span class="text-danger">*</span></label>
                            <select asp-for="StatusKaryawan" class="form-select">
                                @foreach (StatusKaryawan st in Enum.GetValues(typeof(StatusKaryawan)))
                                {
                                    <option value="@st">@st</option>
                                }
                            </select>
                            <span asp-validation-for="StatusKaryawan" class="text-danger small"></span>
                        </div>

                        <div>
                            <label asp-for="TanggalMasuk" class="form-label fw-semibold text-dark">Tanggal Mulai Bekerja <span class="text-danger">*</span></label>
                            <input asp-for="TanggalMasuk" type="date" class="form-control" />
                            <span asp-validation-for="TanggalMasuk" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Kolom Kanan: Rincian Lengkap Karyawan -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-3 p-4">
                        <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                            <i data-lucide="user" style="width: 20px; height: 20px;" class="text-emerald"></i>
                            Informasi Identitas & Kontak
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-5">
                                <label asp-for="NomorIndukKaryawan" class="form-label fw-semibold text-dark">
                                    Nomor Induk Karyawan (NIK) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="NomorIndukKaryawan" class="form-control font-monospace" />
                                <span asp-validation-for="NomorIndukKaryawan" class="text-danger small"></span>
                            </div>

                            <div class="col-md-7">
                                <label asp-for="NamaLengkap" class="form-label fw-semibold text-dark">
                                    Nama Lengkap <span class="text-danger">*</span>
                                </label>
                                <input asp-for="NamaLengkap" class="form-control" />
                                <span asp-validation-for="NamaLengkap" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TempatLahir" class="form-label fw-semibold text-dark">Tempat Lahir</label>
                                <input asp-for="TempatLahir" class="form-control" />
                                <span asp-validation-for="TempatLahir" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TanggalLahir" class="form-label fw-semibold text-dark">
                                    Tanggal Lahir <span class="text-danger">*</span>
                                </label>
                                <input asp-for="TanggalLahir" type="date" class="form-control" />
                                <span asp-validation-for="TanggalLahir" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="JenisKelamin" class="form-label fw-semibold text-dark">
                                    Jenis Kelamin <span class="text-danger">*</span>
                                </label>
                                <select asp-for="JenisKelamin" class="form-select">
                                    <option value="LakiLaki">Laki-laki</option>
                                    <option value="Perempuan">Perempuan</option>
                                </select>
                                <span asp-validation-for="JenisKelamin" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NomorTelepon" class="form-label fw-semibold text-dark">Nomor Telepon / WhatsApp</label>
                                <input asp-for="NomorTelepon" class="form-control" />
                                <span asp-validation-for="NomorTelepon" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-semibold text-dark">
                                    Alamat Email <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Email" type="email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Alamat" class="form-label fw-semibold text-dark">Alamat Domisili</label>
                                <textarea asp-for="Alamat" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Alamat" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mt-4 mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                            <i data-lucide="network" style="width: 20px; height: 20px;" class="text-emerald"></i>
                            Penempatan Kerja
                        </h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DepartemenId" class="form-label fw-semibold text-dark">
                                    Departemen <span class="text-danger">*</span>
                                </label>
                                <select asp-for="DepartemenId" asp-items="Model.OpsiDepartemen" class="form-select" id="selectDepartemen">
                                    <option value="">-- Pilih Departemen --</option>
                                </select>
                                <span asp-validation-for="DepartemenId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="JabatanId" class="form-label fw-semibold text-dark">
                                    Jabatan <span class="text-danger">*</span>
                                </label>
                                <select asp-for="JabatanId" asp-items="Model.OpsiJabatan" class="form-select" id="selectJabatan">
                                    <option value="">-- Pilih Jabatan --</option>
                                </select>
                                <span asp-validation-for="JabatanId" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-light px-4">Batal</a>
                            <button type="submit" class="btn btn-emerald px-4 d-inline-flex align-items-center gap-2">
                                <i data-lucide="check" style="width: 18px; height: 18px;"></i> Simpan Perubahan
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();

        // Image Preview
        const inputFoto = document.getElementById('inputFoto');
        const previewFoto = document.getElementById('previewFoto');
        if (inputFoto && previewFoto) {
            inputFoto.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewFoto.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Cascading Dropdown: Departemen -> Jabatan
        const deptSelect = document.getElementById('selectDepartemen');
        const jabSelect = document.getElementById('selectJabatan');

        if (deptSelect && jabSelect) {
            deptSelect.addEventListener('change', function () {
                const deptId = this.value;
                jabSelect.innerHTML = '<option value="">-- Memuat Jabatan... --</option>';

                if (deptId) {
                    fetch(`/Jabatan/DapatkanBerdasarkanDepartemen?departemenId=${deptId}`)
                        .then(res => res.json())
                        .then(data => {
                            jabSelect.innerHTML = '<option value="">-- Pilih Jabatan --</option>';
                            data.forEach(item => {
                                const opt = document.createElement('option');
                                opt.value = item.id;
                                opt.textContent = item.namaJabatan;
                                jabSelect.appendChild(opt);
                            });
                        })
                        .catch(() => {
                            jabSelect.innerHTML = '<option value="">-- Gagal Memuat --</option>';
                        });
                } else {
                    jabSelect.innerHTML = '<option value="">-- Pilih Departemen Dahulu --</option>';
                }
            });
        }
    </script>
}
