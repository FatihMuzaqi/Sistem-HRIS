@model SistemHRD.ViewModels.KaryawanListViewModel
@using SistemHRD.Models.Enums
@{
    ViewData["Title"] = "Data Karyawan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Dasbor" asp-action="Index" class="text-decoration-none">Dasbor</a></li>
                <li class="breadcrumb-item active" aria-current="page">Karyawan</li>
            </ol>
        </nav>
        <h2 class="h4 fw-bold text-dark mb-0">Manajemen Data Karyawan</h2>
        <p class="text-muted small mb-0">Kelola informasi seluruh staf dan tenaga kerja di perusahaan Anda.</p>
    </div>
    <div>
        <a asp-action="Tambah" class="btn btn-emerald d-inline-flex align-items-center gap-2">
            <i data-lucide="user-plus" style="width: 18px; height: 18px;"></i>
            <span>Tambah Karyawan</span>
        </a>
    </div>
</div>

<!-- Filter & Pencarian Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i data-lucide="search" style="width: 16px; height: 16px;" class="text-muted"></i>
                    </span>
                    <input type="text" name="cari" value="@Model.Cari" class="form-control bg-light border-start-0" placeholder="Cari nama, NIK, email, no HP..." />
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <select name="departemenId" asp-items="Model.OpsiDepartemen" class="form-select bg-light" id="filterDepartemen">
                    <option value="">-- Semua Departemen --</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-6">
                <select name="jabatanId" asp-items="Model.OpsiJabatan" class="form-select bg-light" id="filterJabatan">
                    <option value="">-- Semua Jabatan --</option>
                </select>
            </div>

            <div class="col-lg-2 col-md-6">
                <select name="status" class="form-select bg-light">
                    <option value="">-- Semua Status --</option>
                    @foreach (StatusKaryawan st in Enum.GetValues(typeof(StatusKaryawan)))
                    {
                        if (Model.Status == st)
                        {
                            <option value="@st" selected>@st</option>
                        }
                        else
                        {
                            <option value="@st">@st</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-1 col-md-12 d-flex gap-1">
                <button type="submit" class="btn btn-emerald w-100" title="Cari Data">
                    <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
                </button>
                <a asp-action="Index" class="btn btn-light" title="Reset Filter">
                    <i data-lucide="rotate-ccw" style="width: 16px; height: 16px;"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Daftar Karyawan -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model.DaftarKaryawan == null || !Model.DaftarKaryawan.Any())
        {
            <div class="text-center py-5">
                <div class="avatar-lg bg-light rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i data-lucide="users" class="text-muted" style="width: 32px; height: 32px;"></i>
                </div>
                <h5 class="fw-semibold text-dark">Tidak Ada Data Karyawan</h5>
                <p class="text-muted small">Tidak ditemukan karyawan yang sesuai dengan kriteria filter atau pencarian Anda.</p>
                <a asp-action="Tambah" class="btn btn-sm btn-emerald">Tambah Karyawan Baru</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 25%;">Karyawan</th>
                            <th style="width: 20%;">Departemen & Jabatan</th>
                            <th style="width: 20%;">Kontak</th>
                            <th style="width: 12%;">Tgl Masuk</th>
                            <th class="text-center" style="width: 11%;">Status</th>
                            <th class="text-end pe-4" style="width: 12%;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in Model.DaftarKaryawan)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(k.FotoProfil))
                                        {
                                            <img src="/@k.FotoProfil" alt="@k.NamaLengkap" class="rounded-circle object-fit-cover shadow-sm" style="width: 42px; height: 42px;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-emerald-subtle text-emerald d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 42px; height: 42px; font-size: 15px;">
                                                @k.NamaLengkap.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div>
                                            <a asp-action="Detail" asp-route-id="@k.Id" class="fw-semibold text-dark text-decoration-none d-block hover-emerald">
                                                @k.NamaLengkap
                                            </a>
                                            <span class="badge bg-light text-muted border font-monospace" style="font-size: 11px;">
                                                @k.NomorIndukKaryawan
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@(k.Jabatan?.NamaJabatan ?? "-")</div>
                                    <small class="text-muted">@(k.Departemen?.NamaDepartemen ?? "-")</small>
                                </td>
                                <td>
                                    <div class="small text-dark text-truncate" style="max-width: 200px;">
                                        <i data-lucide="mail" style="width: 13px; height: 13px;" class="text-muted me-1"></i>@k.Email
                                    </div>
                                    <div class="small text-muted">
                                        <i data-lucide="phone" style="width: 13px; height: 13px;" class="text-muted me-1"></i>@(k.NomorTelepon ?? "-")
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-dark">@k.TanggalMasuk.ToString("dd MMM yyyy")</span>
                                </td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = k.StatusKaryawan switch
                                        {
                                            StatusKaryawan.Tetap => "bg-success-subtle text-success",
                                            StatusKaryawan.Kontrak => "bg-info-subtle text-info",
                                            StatusKaryawan.Percobaan => "bg-primary-subtle text-primary",
                                            StatusKaryawan.Magang => "bg-warning-subtle text-warning",
                                            _ => "bg-secondary-subtle text-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-2 py-1">@k.StatusKaryawan</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Detail" asp-route-id="@k.Id" class="btn btn-sm btn-light" title="Detail Karyawan">
                                            <i data-lucide="eye" style="width: 15px; height: 15px;"></i>
                                        </a>
                                        <a asp-action="Ubah" asp-route-id="@k.Id" class="btn btn-sm btn-light" title="Ubah Data">
                                            <i data-lucide="edit-3" style="width: 15px; height: 15px;"></i>
                                        </a>
                                        <div class="dropdown d-inline">
                                            <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i data-lucide="more-vertical" style="width: 15px; height: 15px;"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <form asp-action="UbahStatus" asp-route-id="@k.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 @(k.StatusKaryawan == StatusKaryawan.Nonaktif ? "text-success" : "text-warning")">
                                                            <i data-lucide="power" style="width: 15px; height: 15px;"></i>
                                                            @(k.StatusKaryawan == StatusKaryawan.Nonaktif ? "Aktifkan Karyawan" : "Nonaktifkan Karyawan")
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Pagination -->
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-wrap justify-content-between align-items-center">
                <div class="small text-muted">
                    Menampilkan <strong>@(((Model.HalamanSaatIni - 1) * Model.UkuranHalaman) + 1)</strong> sampai <strong>@(Math.Min(Model.HalamanSaatIni * Model.UkuranHalaman, Model.TotalData))</strong> dari <strong>@Model.TotalData</strong> karyawan
                </div>

                @if (Model.TotalHalaman > 1)
                {
                    <nav aria-label="Navigasi Halaman">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(!Model.AdaHalamanSebelumnya ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-halaman="@(Model.HalamanSaatIni - 1)"
                                   asp-route-cari="@Model.Cari"
                                   asp-route-departemenId="@Model.DepartemenId"
                                   asp-route-jabatanId="@Model.JabatanId"
                                   asp-route-status="@Model.Status">
                                    Sebelumnya
                                </a>
                            </li>

                            @for (int p = 1; p <= Model.TotalHalaman; p++)
                            {
                                <li class="page-item @(p == Model.HalamanSaatIni ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-halaman="@p"
                                       asp-route-cari="@Model.Cari"
                                       asp-route-departemenId="@Model.DepartemenId"
                                       asp-route-jabatanId="@Model.JabatanId"
                                       asp-route-status="@Model.Status">
                                        @p
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.AdaHalamanBerikutnya ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-halaman="@(Model.HalamanSaatIni + 1)"
                                   asp-route-cari="@Model.Cari"
                                   asp-route-departemenId="@Model.DepartemenId"
                                   asp-route-jabatanId="@Model.JabatanId"
                                   asp-route-status="@Model.Status">
                                    Selanjutnya
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        // Cascading Dropdown Filter: Departemen -> Jabatan
        const deptSelect = document.getElementById('filterDepartemen');
        const jabSelect = document.getElementById('filterJabatan');

        if (deptSelect && jabSelect) {
            deptSelect.addEventListener('change', function () {
                const deptId = this.value;
                jabSelect.innerHTML = '<option value="">-- Semua Jabatan --</option>';

                if (deptId) {
                    fetch(`/Jabatan/DapatkanBerdasarkanDepartemen?departemenId=${deptId}`)
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(item => {
                                const opt = document.createElement('option');
                                opt.value = item.id;
                                opt.textContent = item.namaJabatan;
                                jabSelect.appendChild(opt);
                            });
                        });
                }
            });
        }
    </script>
}
