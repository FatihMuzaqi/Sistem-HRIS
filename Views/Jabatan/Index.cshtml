@model List<SistemHRD.Models.Entitas.Jabatan>
@{
    ViewData["Title"] = "Manajemen Jabatan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Dasbor" asp-action="Index" class="text-decoration-none">Dasbor</a></li>
                <li class="breadcrumb-item active" aria-current="page">Jabatan</li>
            </ol>
        </nav>
        <h2 class="h4 fw-bold text-dark mb-0">Manajemen Jabatan</h2>
        <p class="text-muted small mb-0">Kelola posisi hierarki, tingkat level, dan tanggung jawab jabatan di perusahaan.</p>
    </div>
    <div>
        <a asp-action="Tambah" class="btn btn-emerald d-inline-flex align-items-center gap-2">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            <span>Tambah Jabatan</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <div class="avatar-lg bg-light rounded-circle mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i data-lucide="briefcase" class="text-muted" style="width: 32px; height: 32px;"></i>
                </div>
                <h5 class="fw-semibold text-dark">Belum Ada Jabatan</h5>
                <p class="text-muted small">Tambahkan jabatan kerja untuk mengelompokkan tugas dan level karyawan.</p>
                <a asp-action="Tambah" class="btn btn-sm btn-emerald">Tambah Jabatan Baru</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 25%;">Nama Jabatan</th>
                            <th style="width: 25%;">Departemen</th>
                            <th class="text-center" style="width: 15%;">Level</th>
                            <th class="text-center" style="width: 15%;">Karyawan</th>
                            <th class="text-center" style="width: 10%;">Status</th>
                            <th class="text-end pe-4" style="width: 10%;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jab in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@jab.NamaJabatan</div>
                                    @if (!string.IsNullOrEmpty(jab.Deskripsi))
                                    {
                                        <small class="text-muted text-truncate d-block" style="max-width: 280px;">@jab.Deskripsi</small>
                                    }
                                </td>
                                <td>
                                    @if (jab.Departemen != null)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-light text-dark border">@jab.Departemen.KodeDepartemen</span>
                                            <span class="fw-medium text-dark">@jab.Departemen.NamaDepartemen</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Tanpa Departemen</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        string levelBadge = jab.LevelJabatan switch
                                        {
                                            5 => "bg-danger text-white",
                                            4 => "bg-warning text-dark",
                                            3 => "bg-primary text-white",
                                            2 => "bg-info text-dark",
                                            _ => "bg-secondary-subtle text-secondary"
                                        };
                                        string levelLabel = jab.LevelJabatan switch
                                        {
                                            5 => "Level 5 (Direktur)",
                                            4 => "Level 4 (General Manager)",
                                            3 => "Level 3 (Manager)",
                                            2 => "Level 2 (Supervisor)",
                                            _ => "Level 1 (Staff)"
                                        };
                                    }
                                    <span class="badge @levelBadge px-2 py-1">@levelLabel</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary">
                                        @(jab.DaftarKaryawan?.Count ?? 0) Orang
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (jab.StatusAktif)
                                    {
                                        <span class="badge bg-success-subtle text-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i data-lucide="more-vertical" style="width: 16px; height: 16px;"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                            <li>
                                                <a class="dropdown-item d-flex align-items-center gap-2" asp-action="Ubah" asp-route-id="@jab.Id">
                                                    <i data-lucide="edit" style="width: 15px; height: 15px;"></i> Ubah
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalHapus_@jab.Id">
                                                    <i data-lucide="trash-2" style="width: 15px; height: 15px;"></i> Hapus
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Modal Konfirmasi Hapus -->
                                    <div class="modal fade" id="modalHapus_@jab.Id" tabindex="-1" aria-labelledby="labelHapus_@jab.Id" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold" id="labelHapus_@jab.Id">Konfirmasi Penghapusan</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body py-4">
                                                    <p class="text-muted mb-0">Apakah Anda yakin ingin menghapus jabatan <strong class="text-dark">@jab.NamaJabatan</strong>? Jabatan tidak dapat dihapus jika masih terkait dengan data karyawan aktif.</p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
                                                    <form asp-action="Hapus" asp-route-id="@jab.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger">Ya, Hapus</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
