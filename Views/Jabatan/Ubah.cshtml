@model SistemHRD.ViewModels.JabatanFormViewModel
@{
    ViewData["Title"] = "Ubah Jabatan";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-controller="Dasbor" asp-action="Index" class="text-decoration-none">Dasbor</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Jabatan</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Ubah</li>
                    </ol>
                </nav>
                <h2 class="h4 fw-bold text-dark mb-0">Ubah Data Jabatan</h2>
                <p class="text-muted small mb-0">Perbarui spesifikasi jabatan @Model.NamaJabatan.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i> Kembali
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <form asp-action="Ubah" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="NamaJabatan" class="form-label fw-semibold text-dark">
                                Nama Jabatan <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NamaJabatan" class="form-control" />
                            <span asp-validation-for="NamaJabatan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="DepartemenId" class="form-label fw-semibold text-dark">
                                Departemen / Divisi <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DepartemenId" asp-items="Model.OpsiDepartemen" class="form-select">
                                <option value="">-- Pilih Departemen --</option>
                            </select>
                            <span asp-validation-for="DepartemenId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LevelJabatan" class="form-label fw-semibold text-dark">
                                Level Hirarki Jabatan <span class="text-danger">*</span>
                            </label>
                            <select asp-for="LevelJabatan" class="form-select">
                                <option value="1">Level 1 - Staff / Pelaksana</option>
                                <option value="2">Level 2 - Supervisor / Team Lead</option>
                                <option value="3">Level 3 - Manager / Kepala Bagian</option>
                                <option value="4">Level 4 - General Manager / VP</option>
                                <option value="5">Level 5 - C-Level / Direktur</option>
                            </select>
                            <span asp-validation-for="LevelJabatan" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input asp-for="StatusAktif" class="form-check-input" type="checkbox" role="switch" id="switchStatusAktif" />
                                <label class="form-check-label fw-semibold text-dark ms-2" for="switchStatusAktif">
                                    Status Aktif
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Deskripsi" class="form-label fw-semibold text-dark">Deskripsi Tugas & Tanggung Jawab</label>
                            <textarea asp-for="Deskripsi" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Deskripsi" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Batal</a>
                        <button type="submit" class="btn btn-emerald px-4 d-inline-flex align-items-center gap-2">
                            <i data-lucide="check" style="width: 18px; height: 18px;"></i> Simpan Perubahan
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();
    </script>
}
