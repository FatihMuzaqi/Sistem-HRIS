@model SistemHRD.ViewModels.DetailLowonganKerjaViewModel
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = $"Detail Lowongan - {Model.JudulLowongan}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-light text-muted border font-monospace">@Model.KodeLowongan</span>
            @if (Model.Status == StatusLowongan.Dibuka)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Dibuka</span>
            }
            else if (Model.Status == StatusLowongan.Draf)
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Draf</span>
            }
            else
            {
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Ditutup</span>
            }
        </div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">@Model.JudulLowongan</h1>
        <p class="text-muted small mb-0">
            Departemen: <strong>@Model.NamaDepartemen</strong> &bull; Posisi: <strong>@Model.NamaJabatan</strong> &bull; Tipe: <strong>@Model.TipePekerjaan</strong> &bull; Penempatan: <strong>@Model.LokasiKerja</strong>
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Lowongan" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Daftar Lowongan</span>
        </a>
        <a asp-action="DaftarPelamar" asp-route-lowonganId="@Model.Id" class="btn btn-outline-emerald d-inline-flex align-items-center gap-2">
            <i data-lucide="user-plus" style="width: 16px; height: 16px;"></i>
            <span>Daftarkan Pelamar</span>
        </a>
        <a asp-action="UbahLowongan" asp-route-id="@Model.Id" class="btn btn-emerald d-inline-flex align-items-center gap-2 shadow-sm">
            <i data-lucide="edit-3" style="width: 16px; height: 16px;"></i>
            <span>Ubah</span>
        </a>
    </div>
</div>

<!-- Navigasi Tab -->
<ul class="nav nav-tabs mb-4" id="lowonganTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="deskripsi-tab" data-bs-toggle="tab" data-bs-target="#deskripsi-pane" type="button" role="tab">
            <i data-lucide="file-text" style="width: 16px; height: 16px;" class="me-1"></i> Rincian & Kualifikasi
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pelamar-tab" data-bs-toggle="tab" data-bs-target="#pelamar-pane" type="button" role="tab">
            <i data-lucide="users" style="width: 16px; height: 16px;" class="me-1"></i> Daftar Pelamar (@Model.DaftarPelamar.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-semibold" id="pipeline-tab" data-bs-toggle="tab" data-bs-target="#pipeline-pane" type="button" role="tab">
            <i data-lucide="git-pull-request" style="width: 16px; height: 16px;" class="me-1"></i> Pipeline Seleksi (@Model.DaftarTahapan.Count)
        </button>
    </li>
</ul>

<div class="tab-content" id="lowonganTabsContent">
    <!-- Tab 1: Deskripsi & Kualifikasi -->
    <div class="tab-pane fade show active" id="deskripsi-pane" role="tabpanel">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold text-slate-800 mb-0">Deskripsi Tugas & Tanggung Jawab</h6>
                    </div>
                    <div class="card-body p-4 text-slate-700" style="white-space: pre-line; line-height: 1.7;">@Model.DeskripsiPekerjaan</div>
                </div>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold text-slate-800 mb-0">Persyaratan & Kualifikasi</h6>
                    </div>
                    <div class="card-body p-4 text-slate-700" style="white-space: pre-line; line-height: 1.7;">@Model.Kualifikasi</div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="fw-bold text-slate-800 mb-0">Ringkasan Posisi</h6>
                    </div>
                    <div class="card-body p-3">
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Kuota Kebutuhan:</span>
                                <span class="fw-bold font-monospace">@Model.JumlahDibutuhkan Orang</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Estimasi Gaji:</span>
                                <span class="fw-bold font-monospace text-emerald">
                                    @if (Model.GajiMin.HasValue && Model.GajiMax.HasValue)
                                    {
                                        <span>Rp @Model.GajiMin.Value.ToString("N0") &mdash; @Model.GajiMax.Value.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span>Negosiasi</span>
                                    }
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Tanggal Dibuka:</span>
                                <span>@Model.TanggalDibuka.ToString("dd MMMM yyyy")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Batas Penutupan:</span>
                                <span>@(Model.TanggalDitutup?.ToString("dd MMMM yyyy") ?? "-")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0 py-2">
                                <span class="text-muted">Total Pelamar:</span>
                                <span class="badge bg-emerald-light text-emerald fw-bold">@Model.DaftarPelamar.Count</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 2: Pelamar Terdaftar -->
    <div class="tab-pane fade" id="pelamar-pane" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3 py-3">No. Registrasi</th>
                                <th>Nama Lengkap</th>
                                <th>Kontak</th>
                                <th>Pendidikan / Pengalaman</th>
                                <th>Gaji Diharapkan</th>
                                <th class="text-center">Status</th>
                                <th class="text-end pe-3">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @if (Model.DaftarPelamar.Any())
                            {
                                foreach (var p in Model.DaftarPelamar)
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace text-emerald fw-bold">
                                            @p.NomorRegistrasi
                                        </td>
                                        <td>
                                            <div class="fw-bold text-slate-800">@p.NamaLengkap</div>
                                            <small class="text-muted">Melamar: @p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            <div class="small">@p.Email</div>
                                            <div class="text-muted small font-monospace">@p.NomorTelepon</div>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-slate-700">@p.PendidikanTerakhir (@(p.NamaInstitusi ?? "-"))</div>
                                            <div class="text-muted small">Pengalaman: @p.PengalamanKerjaTahun Tahun</div>
                                        </td>
                                        <td class="font-monospace small">
                                            @(p.GajiDiharapkan.HasValue ? $"Rp {p.GajiDiharapkan.Value:N0}" : "-")
                                        </td>
                                        <td class="text-center">
                                            @switch (p.Status)
                                            {
                                                case StatusPelamar.Baru:
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Baru</span>
                                                    break;
                                                case StatusPelamar.LolosAdministrasi:
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Lolos Berkas</span>
                                                    break;
                                                case StatusPelamar.Wawancara:
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Wawancara</span>
                                                    break;
                                                case StatusPelamar.PenawaranKerja:
                                                    <span class="badge bg-warning text-dark px-2 py-1">Offering</span>
                                                    break;
                                                case StatusPelamar.Diterima:
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Diterima (Hired)</span>
                                                    break;
                                                case StatusPelamar.Ditolak:
                                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Ditolak</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-muted border px-2 py-1">@p.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-action="DetailPelamar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-emerald">
                                                Lihat Profil
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i data-lucide="user-x" style="width: 32px; height: 32px;" class="mb-2 text-muted"></i>
                                        <p class="mb-0">Belum ada pelamar yang mendaftar pada lowongan ini.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 3: Pipeline Tahapan Seleksi -->
    <div class="tab-pane fade" id="pipeline-pane" role="tabpanel">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-slate-800 mb-0">Alur Pipeline Tahapan Seleksi</h6>
                <span class="badge bg-light text-muted border">Urutan Seleksi</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    @foreach (var t in Model.DaftarTahapan)
                    {
                        <div class="col-md-6 col-lg-3">
                            <div class="p-3 rounded-3 border bg-light h-100 position-relative">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-emerald text-white rounded-circle p-2" style="width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                        @t.Urutan
                                    </span>
                                    <h6 class="fw-bold text-slate-800 mb-0">@t.NamaTahapan</h6>
                                </div>
                                <span class="badge bg-white text-slate-700 border small">@t.JenisTahapan</span>
                                <p class="text-muted small mt-2 mb-0">@(t.Keterangan ?? "Tahapan seleksi penilaian kompetensi.")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
