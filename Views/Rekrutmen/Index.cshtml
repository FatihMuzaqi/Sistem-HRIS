@model SistemHRD.ViewModels.DashboardRekrutmenViewModel
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Dashboard Rekrutmen";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Dashboard Rekrutmen & Pelamar</h1>
        <p class="text-muted small mb-0">Pantau pipeline akuisisi talenta, status lowongan aktif, dan penjadwalan wawancara kandidat.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Lowongan" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="briefcase" style="width: 16px; height: 16px;"></i>
            <span>Daftar Lowongan</span>
        </a>
        <a asp-action="TambahLowongan" class="btn btn-emerald d-inline-flex align-items-center gap-2 shadow-sm">
            <i data-lucide="plus-circle" style="width: 16px; height: 16px;"></i>
            <span>Buka Lowongan Baru</span>
        </a>
    </div>
</div>

<!-- Kartu Metrik Ringkasan -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium">Lowongan Aktif</span>
                    <h3 class="fw-bold text-slate-800 my-1">@Model.TotalLowonganAktif</h3>
                    <span class="badge bg-emerald-light text-emerald small font-monospace">Dibuka Publik</span>
                </div>
                <div class="rounded-3 p-3 bg-emerald-light text-emerald">
                    <i data-lucide="briefcase" style="width: 24px; height: 24px;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium">Pelamar Baru</span>
                    <h3 class="fw-bold text-slate-800 my-1">@Model.TotalPelamarBaru</h3>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small">Perlu Review</span>
                </div>
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                    <i data-lucide="user-plus" style="width: 24px; height: 24px;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium">Kandidat Dalam Proses</span>
                    <h3 class="fw-bold text-slate-800 my-1">@Model.TotalDalamProses</h3>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 small">Seleksi & Interview</span>
                </div>
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info">
                    <i data-lucide="users" style="width: 24px; height: 24px;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium">Kandidat Diterima</span>
                    <h3 class="fw-bold text-slate-800 my-1">@Model.TotalDiterima</h3>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">Hired (Karyawan)</span>
                </div>
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                    <i data-lucide="user-check" style="width: 24px; height: 24px;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Grafik Visualisasi Chart.js -->
<div class="row g-4 mb-4">
    <!-- Doughnut Chart: Status Pelamar -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-slate-800 mb-0">Pipeline Distribusi Pelamar</h6>
                <span class="badge bg-light text-muted border">Tahapan Seleksi</span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center p-4">
                <div style="position: relative; height: 240px; width: 100%;">
                    <canvas id="chartStatusPelamar"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Bar Chart: Pelamar per Lowongan -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-slate-800 mb-0">Antusiasme Pelamar per Lowongan</h6>
                <span class="badge bg-light text-muted border">Top Posisi</span>
            </div>
            <div class="card-body p-4">
                <div style="position: relative; height: 240px; width: 100%;">
                    <canvas id="chartPelamarPerLowongan"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabel Wawancara Mendatang & Lowongan Terbaru -->
<div class="row g-4">
    <!-- Wawancara Mendatang -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-slate-800 mb-0">Jadwal Wawancara Mendatang</h6>
                <span class="badge bg-emerald-light text-emerald">Aktif</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3 py-2">Kandidat</th>
                                <th>Posisi</th>
                                <th>Waktu</th>
                                <th class="text-end pe-3">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @if (Model.WawancaraMendatang.Any())
                            {
                                foreach (var w in Model.WawancaraMendatang)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-bold text-slate-800">@w.NamaPelamar</div>
                                            <small class="text-muted">Pewawancara: @w.NamaPewawancara</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-slate-700 border">@w.JudulLowongan</span>
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-slate-700">@w.TanggalWawancara.ToString("dd MMM yyyy")</div>
                                            <small class="text-muted font-monospace">@w.JamMulai.ToString(@"hh\:mm") - @w.JamSelesai.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td class="text-end pe-3">
                                            <a asp-action="DetailPelamar" asp-route-id="@w.PelamarId" class="btn btn-sm btn-outline-emerald">
                                                Detail
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted small">Belum ada agenda wawancara mendatang.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Lowongan Terbaru -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-slate-800 mb-0">Lowongan Pekerjaan Terbaru</h6>
                <a asp-action="Lowongan" class="small text-emerald fw-semibold text-decoration-none">Lihat Semua</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3 py-2">Posisi Lowongan</th>
                                <th>Departemen</th>
                                <th class="text-center">Pelamar</th>
                                <th class="text-end pe-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y">
                            @if (Model.LowonganTerbaru.Any())
                            {
                                foreach (var l in Model.LowonganTerbaru)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-action="DetailLowongan" asp-route-id="@l.Id" class="fw-bold text-slate-800 text-decoration-none hover-emerald">
                                                @l.JudulLowongan
                                            </a>
                                            <div class="text-muted small">@l.LokasiKerja &bull; @l.TipePekerjaan</div>
                                        </td>
                                        <td>
                                            <span class="small fw-semibold text-slate-700">@l.NamaDepartemen</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-emerald-light text-emerald fw-bold">@l.JumlahPelamar</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            @if (l.Status == StatusLowongan.Dibuka)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Dibuka</span>
                                            }
                                            else if (l.Status == StatusLowongan.Draf)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Draf</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1">@l.Status</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted small">Belum ada lowongan pekerjaan aktif.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Chart Status Pelamar (Doughnut)
            const ctxStatus = document.getElementById('chartStatusPelamar').getContext('2d');
            const dataStatus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatistikStatusPelamar));

            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(dataStatus),
                    datasets: [{
                        data: Object.values(dataStatus),
                        backgroundColor: [
                            '#3b82f6', // Baru - Blue
                            '#eab308', // Administrasi - Yellow
                            '#a855f7', // Wawancara - Purple
                            '#f97316', // Offering - Orange
                            '#10b981', // Diterima - Emerald
                            '#ef4444'  // Ditolak - Red
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, padding: 15, font: { family: 'Inter', size: 11 } } }
                    },
                    cutout: '65%'
                }
            });

            // 2. Chart Pelamar per Lowongan (Bar)
            const ctxLowongan = document.getElementById('chartPelamarPerLowongan').getContext('2d');
            const dataLowongan = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StatistikPelamarPerLowongan));

            new Chart(ctxLowongan, {
                type: 'bar',
                data: {
                    labels: Object.keys(dataLowongan),
                    datasets: [{
                        label: 'Jumlah Pelamar',
                        data: Object.values(dataLowongan),
                        backgroundColor: '#059669',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { family: 'Inter', size: 11 } },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            ticks: { font: { family: 'Inter', size: 10 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        });
    </script>
}
