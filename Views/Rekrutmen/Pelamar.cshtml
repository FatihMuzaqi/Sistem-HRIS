@model List<SistemHRD.ViewModels.PelamarItemViewModel>
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Daftar Pelamar";
    var statusTerpilih = ViewBag.StatusTerpilih as StatusPelamar?;
    var lowonganIdTerpilih = ViewBag.LowonganIdTerpilih as Guid?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Daftar Pelamar & Kandidat</h1>
        <p class="text-muted small mb-0">Kelola berkas CV, seleksi administrasi, jadwal wawancara, dan penerimaan kandidat.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="layout-dashboard" style="width: 16px; height: 16px;"></i>
            <span>Dashboard</span>
        </a>
        <a asp-action="DaftarPelamar" class="btn btn-emerald d-inline-flex align-items-center gap-2 shadow-sm">
            <i data-lucide="user-plus" style="width: 16px; height: 16px;"></i>
            <span>Registrasi Pelamar Baru</span>
        </a>
    </div>
</div>

<!-- Filter Lowongan & Status -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-slate-700">Filter Lowongan</label>
                <select name="lowonganId" asp-items="ViewBag.DaftarLowongan" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Semua Lowongan --</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-slate-700">Filter Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Semua Status --</option>
                    <option value="1" selected="@(statusTerpilih == StatusPelamar.Baru)">Baru</option>
                    <option value="2" selected="@(statusTerpilih == StatusPelamar.SeleksiAdministrasi)">Seleksi Administrasi</option>
                    <option value="3" selected="@(statusTerpilih == StatusPelamar.LolosAdministrasi)">Lolos Administrasi</option>
                    <option value="4" selected="@(statusTerpilih == StatusPelamar.Wawancara)">Wawancara</option>
                    <option value="5" selected="@(statusTerpilih == StatusPelamar.PenawaranKerja)">Offering (Penawaran Kerja)</option>
                    <option value="6" selected="@(statusTerpilih == StatusPelamar.Diterima)">Diterima (Hired)</option>
                    <option value="7" selected="@(statusTerpilih == StatusPelamar.Ditolak)">Ditolak</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Pelamar" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabel Pelamar -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">No. Registrasi</th>
                        <th>Nama & Kontak</th>
                        <th>Posisi Dilamar</th>
                        <th>Pendidikan & Pengalaman</th>
                        <th>Gaji Diharapkan</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 font-monospace text-emerald fw-bold">
                                    @item.NomorRegistrasi
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-800">@item.NamaLengkap</div>
                                    <div class="small text-muted">@item.Email &bull; <span class="font-monospace">@item.NomorTelepon</span></div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-slate-800 border">@item.JudulLowongan</span>
                                    <div class="text-muted small mt-1">@item.CreatedAt.ToString("dd MMM yyyy")</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-slate-700">@item.PendidikanTerakhir (@(item.NamaInstitusi ?? "-"))</div>
                                    <div class="text-muted small">Pengalaman: @item.PengalamanKerjaTahun Tahun</div>
                                </td>
                                <td class="font-monospace small">
                                    @(item.GajiDiharapkan.HasValue ? $"Rp {item.GajiDiharapkan.Value:N0}" : "-")
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case StatusPelamar.Baru:
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Baru</span>
                                            break;
                                        case StatusPelamar.LolosAdministrasi:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Lolos Berkas</span>
                                            break;
                                        case StatusPelamar.Wawancara:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Wawancara</span>
                                            break;
                                        case StatusPelamar.PenawaranKerja:
                                            <span class="badge bg-warning text-dark px-2 py-1">Offering</span>
                                            break;
                                        case StatusPelamar.Diterima:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Diterima (Hired)</span>
                                            break;
                                        case StatusPelamar.Ditolak:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Ditolak</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-muted border px-2 py-1">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="DetailPelamar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-emerald">
                                        Detail Profil
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i data-lucide="user-x" style="width: 32px; height: 32px;" class="mb-2 text-muted"></i>
                                <p class="mb-0">Tidak ada pelamar ditemukan pada kriteria filter ini.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
