@model SistemHRD.ViewModels.RekapKehadiranViewModel

@{
    ViewData["Title"] = "Rekapitulasi Kehadiran Bulanan";
    var namaBulan = new[] { "", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember" };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Rekapitulasi Kehadiran Bulanan</h1>
        <p class="text-muted small mb-0">Laporan agregat presensi kerja untuk periode @namaBulan[Model.Bulan] @Model.Tahun.</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="printer" style="width: 16px; height: 16px;"></i>
            <span>Cetak Rekap</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Kembali ke Harian</span>
        </a>
    </div>
</div>

<!-- Filter Bulan & Tahun -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Bulan</label>
                <select name="bulan" class="form-select form-select-sm">
                    @for (int b = 1; b <= 12; b++)
                    {
                        <option value="@b" selected="@(b == Model.Bulan)">@namaBulan[b]</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Tahun</label>
                <select name="tahun" class="form-select form-select-sm">
                    @for (int y = DateTime.Today.Year - 2; y <= DateTime.Today.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == Model.Tahun)">@y</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Departemen</label>
                <select name="departemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select form-select-sm">
                    <option value="">-- Semua Departemen --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-sm btn-emerald w-100">
                    <i data-lucide="search" style="width: 16px; height: 16px;" class="me-1"></i>
                    Tampilkan Rekap
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Tabel Rekapitulasi -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0 text-center">
                <thead class="bg-light text-muted small align-middle">
                    <tr>
                        <th rowspan="2" class="text-start ps-3">Karyawan</th>
                        <th rowspan="2">Departemen</th>
                        <th colspan="6" class="text-center bg-light">Jumlah Hari Kehadiran</th>
                        <th rowspan="2">Keterlambatan (Menit)</th>
                        <th rowspan="2">Jam Kerja</th>
                        <th rowspan="2" class="pe-3">Jam Lembur</th>
                    </tr>
                    <tr>
                        <th class="text-success small">Hadir</th>
                        <th class="text-warning small">Terlambat</th>
                        <th class="text-info small">Izin</th>
                        <th class="text-primary small">Sakit</th>
                        <th class="text-purple small">Cuti</th>
                        <th class="text-danger small">Alpa</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.DaftarRekap.Any())
                    {
                        foreach (var item in Model.DaftarRekap)
                        {
                            <tr>
                                <td class="text-start ps-3">
                                    <div class="fw-bold text-slate-800">@item.NamaKaryawan</div>
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@item.NomorIndukKaryawan</span>
                                </td>
                                <td>@item.NamaDepartemen</td>
                                <td class="fw-bold text-success">@item.TotalHadir</td>
                                <td class="fw-bold text-warning">@item.TotalTerlambat</td>
                                <td class="fw-bold text-info">@item.TotalIzin</td>
                                <td class="fw-bold text-primary">@item.TotalSakit</td>
                                <td class="fw-bold text-purple">@item.TotalCuti</td>
                                <td class="fw-bold text-danger">@item.TotalAlpa</td>
                                <td>
                                    @if (item.TotalMenitKeterlambatan > 0)
                                    {
                                        <span class="badge bg-warning text-dark font-monospace">@item.TotalMenitKeterlambatan m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="fw-bold text-slate-800">@item.TotalJamKerja jam</td>
                                <td class="pe-3 fw-bold text-emerald">@item.TotalJamLembur jam</td>
                            </tr>
                        }
                        <tr class="table-light fw-bold">
                            <td colspan="2" class="text-start ps-3">TOTAL KESELURUHAN</td>
                            <td class="text-success">@Model.DaftarRekap.Sum(r => r.TotalHadir)</td>
                            <td class="text-warning">@Model.DaftarRekap.Sum(r => r.TotalTerlambat)</td>
                            <td class="text-info">@Model.DaftarRekap.Sum(r => r.TotalIzin)</td>
                            <td class="text-primary">@Model.DaftarRekap.Sum(r => r.TotalSakit)</td>
                            <td class="text-purple">@Model.DaftarRekap.Sum(r => r.TotalCuti)</td>
                            <td class="text-danger">@Model.DaftarRekap.Sum(r => r.TotalAlpa)</td>
                            <td class="font-monospace">@Model.DaftarRekap.Sum(r => r.TotalMenitKeterlambatan) m</td>
                            <td>@Model.DaftarRekap.Sum(r => r.TotalJamKerja) jam</td>
                            <td class="pe-3 text-emerald">@Model.DaftarRekap.Sum(r => r.TotalJamLembur) jam</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                Tidak ada data karyawan aktif untuk periode ini.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
