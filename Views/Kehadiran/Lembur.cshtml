@model SistemHRD.ViewModels.DaftarLemburViewModel
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Pengajuan & Persetujuan Lembur";
    var canApprove = User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD) || User.IsInRole(NamaPeran.Manager);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Pengajuan & Persetujuan Lembur</h1>
        <p class="text-muted small mb-0">Kelola permohonan jam kerja lembur dan persetujuan penugasan lembur karyawan.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-emerald d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalAjukanLembur">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            <span>Ajukan Lembur</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 18px; height: 18px;"></i>
            <span>Kembali ke Presensi</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">No. Pengajuan</th>
                        <th>Karyawan</th>
                        <th>Tanggal Lembur</th>
                        <th>Waktu (Mulai - Selesai)</th>
                        <th>Total Jam</th>
                        <th>Alasan Lembur</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.DaftarLembur.Any())
                    {
                        foreach (var item in Model.DaftarLembur)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-emerald">@item.NomorPengajuan</td>
                                <td>
                                    <div class="fw-bold text-slate-800">@item.NamaKaryawan</div>
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@item.NomorIndukKaryawan</span>
                                </td>
                                <td class="fw-medium text-slate-800">@item.TanggalLembur.ToString("dd MMM yyyy")</td>
                                <td class="font-monospace">
                                    @item.JamMulai.ToString(@"hh\:mm") - @item.JamSelesai.ToString(@"hh\:mm")
                                </td>
                                <td class="fw-bold text-emerald">@item.TotalJam jam</td>
                                <td class="small text-slate-600" style="max-width: 250px;">@item.AlasanLembur</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case StatusPengajuanLembur.MenungguPersetujuan:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Menunggu Persetujuan</span>
                                            break;
                                        case StatusPengajuanLembur.Disetujui:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Disetujui</span>
                                            break;
                                        case StatusPengajuanLembur.Ditolak:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Ditolak</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (canApprove && item.Status == StatusPengajuanLembur.MenungguPersetujuan)
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="ProsesPersetujuanLembur" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="PengajuanLemburId" value="@item.Id" />
                                                <input type="hidden" name="Disetujui" value="true" />
                                                <input type="hidden" name="Catatan" value="Disetujui oleh atasan" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Setujui Lembur">
                                                    <i data-lucide="check" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            </form>
                                            <form asp-action="ProsesPersetujuanLembur" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="PengajuanLemburId" value="@item.Id" />
                                                <input type="hidden" name="Disetujui" value="false" />
                                                <input type="hidden" name="Catatan" value="Ditolak oleh atasan" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Tolak Lembur">
                                                    <i data-lucide="x" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else if (item.WaktuPersetujuan.HasValue)
                                    {
                                        <span class="small text-muted">@item.DisetujuiOleh</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Belum ada pengajuan lembur tercatat.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Form Ajukan Lembur -->
<div class="modal fade" id="modalAjukanLembur" tabindex="-1" aria-labelledby="modalAjukanLemburLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AjukanLembur" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-slate-800" id="modalAjukanLemburLabel">
                        <i data-lucide="clock-alert" style="width: 20px; height: 20px;" class="me-1 text-emerald"></i>
                        Ajukan Kerja Lembur
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Tanggal Lembur <span class="text-danger">*</span></label>
                            <input type="date" name="TanggalLembur" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Jam Mulai <span class="text-danger">*</span></label>
                            <input type="time" name="JamMulai" class="form-control" value="17:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Jam Selesai <span class="text-danger">*</span></label>
                            <input type="time" name="JamSelesai" class="form-control" value="20:00" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Alasan Lembur <span class="text-danger">*</span></label>
                            <textarea name="AlasanLembur" class="form-control" rows="3" placeholder="Jelaskan kebutuhan pekerjaan atau target penyelesaian tugas..." required maxlength="500"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-emerald">Kirim Pengajuan</button>
                </div>
            </form>
        </div>
    </div>
</div>
