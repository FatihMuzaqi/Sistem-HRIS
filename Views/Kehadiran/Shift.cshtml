@model List<SistemHRD.Models.Entitas.ShiftKerja>

@{
    ViewData["Title"] = "Pengaturan Shift Kerja";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Pengaturan Shift Kerja</h1>
        <p class="text-muted small mb-0">Kelola master jadwal shift operasional, toleransi keterlambatan, dan jam kerja.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-emerald d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalTambahShift">
            <i data-lucide="plus" style="width: 18px; height: 18px;"></i>
            <span>Tambah Shift Baru</span>
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 18px; height: 18px;"></i>
            <span>Kembali</span>
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">Kode Shift</th>
                        <th>Nama Shift</th>
                        <th>Jam Masuk</th>
                        <th>Jam Pulang</th>
                        <th>Toleransi Keterlambatan</th>
                        <th>Status</th>
                        <th>Keterangan</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Any())
                    {
                        foreach (var shift in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold font-monospace text-emerald">@shift.KodeShift</td>
                                <td class="fw-bold text-slate-800">@shift.NamaShift</td>
                                <td class="font-monospace fw-semibold">@shift.JamMasuk.ToString(@"hh\:mm")</td>
                                <td class="font-monospace fw-semibold">@shift.JamPulang.ToString(@"hh\:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@shift.ToleransiKeterlambatanMenit menit</span>
                                </td>
                                <td>
                                    @if (shift.StatusAktif)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Nonaktif</span>
                                    }
                                </td>
                                <td class="small text-muted">@(shift.Keterangan ?? "-")</td>
                                <td class="text-end pe-3">
                                    <form asp-action="HapusShift" asp-route-id="@shift.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus shift @shift.NamaShift?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus Shift">
                                            <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Belum ada shift kerja terdaftar. Klik 'Tambah Shift Baru' untuk menambahkan.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tambah Shift Baru -->
<div class="modal fade" id="modalTambahShift" tabindex="-1" aria-labelledby="modalTambahShiftLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="SimpanShift" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-slate-800" id="modalTambahShiftLabel">
                        <i data-lucide="plus-circle" style="width: 20px; height: 20px;" class="me-1 text-emerald"></i>
                        Tambah Shift Kerja Baru
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Kode Shift <span class="text-danger">*</span></label>
                            <input type="text" name="KodeShift" class="form-control" placeholder="Contoh: REG / SFT-1" required maxlength="20" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Nama Shift <span class="text-danger">*</span></label>
                            <input type="text" name="NamaShift" class="form-control" placeholder="Contoh: Shift Pagi Regular" required maxlength="50" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Jam Masuk <span class="text-danger">*</span></label>
                            <input type="time" name="JamMasuk" class="form-control" value="08:00" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Jam Pulang <span class="text-danger">*</span></label>
                            <input type="time" name="JamPulang" class="form-control" value="17:00" required />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Toleransi Keterlambatan (Menit)</label>
                            <input type="number" name="ToleransiKeterlambatanMenit" class="form-control" value="15" min="0" max="120" />
                            <small class="text-muted">Presensi masuk melewati toleransi ini akan tercatat sebagai 'Terlambat'.</small>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Keterangan (Opsional)</label>
                            <textarea name="Keterangan" class="form-control" rows="2" placeholder="Catatan operasional shift..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="StatusAktif" value="true" id="shiftStatusAktif" checked />
                                <label class="form-check-label fw-semibold small" for="shiftStatusAktif">Shift Aktif</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-emerald">Simpan Shift</button>
                </div>
            </form>
        </div>
    </div>
</div>
