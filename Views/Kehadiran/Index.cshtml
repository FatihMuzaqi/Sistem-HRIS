@model SistemHRD.ViewModels.DaftarKehadiranViewModel
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Kehadiran & Presensi";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Kehadiran & Presensi</h1>
        <p class="text-muted small mb-0">Pantau aktivitas presensi, jam kerja, keterlambatan, dan kehadiran karyawan secara real-time.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Presensi" class="btn btn-emerald d-inline-flex align-items-center gap-2">
            <i data-lucide="clock" style="width: 18px; height: 18px;"></i>
            <span>Presensi Mandiri (Clock In/Out)</span>
        </a>
        @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD) || User.IsInRole(NamaPeran.Manager) || User.IsInRole(NamaPeran.Finance))
        {
            <a asp-action="Rekap" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i data-lucide="file-spreadsheet" style="width: 18px; height: 18px;"></i>
                <span>Rekapitulasi Bulanan</span>
            </a>
        }
        @if (User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD))
        {
            <a asp-action="Shift" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i data-lucide="calendar" style="width: 18px; height: 18px;"></i>
                <span>Pengaturan Shift</span>
            </a>
        }
        <a asp-action="Lembur" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="clock-alert" style="width: 18px; height: 18px;"></i>
            <span>Lembur</span>
        </a>
    </div>
</div>

<!-- Kartu Statistik -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-emerald shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Tepat Waktu</span>
                <div class="stat-icon bg-emerald-light text-emerald rounded p-1">
                    <i data-lucide="check-circle-2" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalHadir</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-warning shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Terlambat</span>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded p-1">
                    <i data-lucide="alert-triangle" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalTerlambat</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-info shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Izin</span>
                <div class="stat-icon bg-info bg-opacity-10 text-info rounded p-1">
                    <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalIzin</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-primary shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Sakit</span>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded p-1">
                    <i data-lucide="heart-pulse" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalSakit</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-purple shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Cuti</span>
                <div class="stat-icon bg-secondary bg-opacity-10 text-purple rounded p-1">
                    <i data-lucide="calendar-off" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalCuti</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-start border-4 border-danger shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Alpa</span>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger rounded p-1">
                    <i data-lucide="x-circle" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalAlpa</div>
        </div>
    </div>
</div>

<!-- Filter Box -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Tanggal Mulai</label>
                <input type="date" name="TanggalMulai" class="form-control form-control-sm" value="@(Model.Filter.TanggalMulai?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Tanggal Selesai</label>
                <input type="date" name="TanggalSelesai" class="form-control form-control-sm" value="@(Model.Filter.TanggalSelesai?.ToString("yyyy-MM-dd"))" />
            </div>
            @if (!User.IsInRole(NamaPeran.Karyawan))
            {
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-muted">Departemen</label>
                    <select name="DepartemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select form-select-sm">
                        <option value="">-- Semua Departemen --</option>
                    </select>
                </div>
            }
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">-- Semua Status --</option>
                    <option value="1" selected="@(Model.Filter.Status == StatusKehadiran.Hadir)">Hadir</option>
                    <option value="2" selected="@(Model.Filter.Status == StatusKehadiran.Terlambat)">Terlambat</option>
                    <option value="3" selected="@(Model.Filter.Status == StatusKehadiran.Izin)">Izin</option>
                    <option value="4" selected="@(Model.Filter.Status == StatusKehadiran.Sakit)">Sakit</option>
                    <option value="5" selected="@(Model.Filter.Status == StatusKehadiran.Cuti)">Cuti</option>
                    <option value="6" selected="@(Model.Filter.Status == StatusKehadiran.Alpa)">Alpa</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Cari Karyawan / NIK</label>
                <input type="text" name="Cari" class="form-control form-control-sm" placeholder="Nama atau NIK..." value="@Model.Filter.Cari" />
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-emerald w-100" title="Terapkan Filter">
                    <i data-lucide="filter" style="width: 16px; height: 16px;"></i>
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filter">
                    <i data-lucide="rotate-ccw" style="width: 16px; height: 16px;"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabel Kehadiran -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">Tanggal</th>
                        <th>Karyawan</th>
                        <th>Departemen</th>
                        <th>Shift</th>
                        <th>Masuk</th>
                        <th>Pulang</th>
                        <th>Total Jam</th>
                        <th>Status</th>
                        <th class="pe-3">Lokasi / Catatan</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.DaftarKehadiran.Any())
                    {
                        foreach (var item in Model.DaftarKehadiran)
                        {
                            <tr>
                                <td class="ps-3 fw-medium text-slate-800">
                                    @item.Tanggal.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-900">@item.NamaKaryawan</div>
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@item.NomorIndukKaryawan</span>
                                </td>
                                <td>
                                    <span class="text-slate-700">@item.NamaDepartemen</span>
                                    <div class="small text-muted">@item.NamaJabatan</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@item.NamaShift</span>
                                </td>
                                <td>
                                    @if (item.WaktuMasuk.HasValue)
                                    {
                                        <div class="fw-bold text-slate-800">@item.WaktuMasuk.Value.ToString("HH:mm:ss")</div>
                                        @if (item.MenitKeterlambatan > 0)
                                        {
                                            <span class="badge bg-warning text-dark font-monospace" style="font-size: 0.7rem;">+@item.MenitKeterlambatan m</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.WaktuPulang.HasValue)
                                    {
                                        <div class="fw-bold text-slate-800">@item.WaktuPulang.Value.ToString("HH:mm:ss")</div>
                                        @if (item.MenitPulangCepat > 0)
                                        {
                                            <span class="badge bg-secondary text-white font-monospace" style="font-size: 0.7rem;">Pulang Cepat @item.MenitPulangCepat m</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TotalJamKerja > 0)
                                    {
                                        <span class="fw-bold text-emerald">@item.TotalJamKerja jam</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case StatusKehadiran.Hadir:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Hadir</span>
                                            break;
                                        case StatusKehadiran.Terlambat:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Terlambat</span>
                                            break;
                                        case StatusKehadiran.Izin:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Izin</span>
                                            break;
                                        case StatusKehadiran.Sakit:
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">Sakit</span>
                                            break;
                                        case StatusKehadiran.Cuti:
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Cuti</span>
                                            break;
                                        case StatusKehadiran.Alpa:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Alpa</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-muted">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="pe-3 small text-muted">
                                    @if (!string.IsNullOrEmpty(item.LokasiMasuk))
                                    {
                                        <div><i data-lucide="map-pin" style="width: 12px; height: 12px;" class="me-1"></i>@item.LokasiMasuk</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.CatatanMasuk))
                                    {
                                        <div class="fst-italic text-slate-500">"@item.CatatanMasuk"</div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5">
                                <div class="text-muted">
                                    <i data-lucide="calendar-x" style="width: 48px; height: 48px; opacity: 0.3;" class="mb-2"></i>
                                    <p class="mb-0 fw-medium">Belum ada riwayat kehadiran pada kriteria ini.</p>
                                    <small class="text-muted">Gunakan tombol 'Presensi Mandiri' untuk melakukan Check-In harian.</small>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginasi -->
    @if (Model.TotalHalaman > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="small text-muted">
                Menampilkan halaman @Model.HalamanSaatIni dari @Model.TotalHalaman (Total @Model.TotalItem data)
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HalamanSaatIni == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-Halaman="@(Model.HalamanSaatIni - 1)"
                           asp-route-TanggalMulai="@Model.Filter.TanggalMulai?.ToString("yyyy-MM-dd")"
                           asp-route-TanggalSelesai="@Model.Filter.TanggalSelesai?.ToString("yyyy-MM-dd")"
                           asp-route-DepartemenId="@Model.Filter.DepartemenId"
                           asp-route-Status="@((int?)Model.Filter.Status)"
                           asp-route-Cari="@Model.Filter.Cari">Sebelumnya</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalHalaman; p++)
                    {
                        <li class="page-item @(p == Model.HalamanSaatIni ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-Halaman="@p"
                               asp-route-TanggalMulai="@Model.Filter.TanggalMulai?.ToString("yyyy-MM-dd")"
                               asp-route-TanggalSelesai="@Model.Filter.TanggalSelesai?.ToString("yyyy-MM-dd")"
                               asp-route-DepartemenId="@Model.Filter.DepartemenId"
                               asp-route-Status="@((int?)Model.Filter.Status)"
                               asp-route-Cari="@Model.Filter.Cari">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HalamanSaatIni == Model.TotalHalaman ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-Halaman="@(Model.HalamanSaatIni + 1)"
                           asp-route-TanggalMulai="@Model.Filter.TanggalMulai?.ToString("yyyy-MM-dd")"
                           asp-route-TanggalSelesai="@Model.Filter.TanggalSelesai?.ToString("yyyy-MM-dd")"
                           asp-route-DepartemenId="@Model.Filter.DepartemenId"
                           asp-route-Status="@((int?)Model.Filter.Status)"
                           asp-route-Cari="@Model.Filter.Cari">Selanjutnya</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
