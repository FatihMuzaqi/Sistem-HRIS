@model SistemHRD.ViewModels.KehadiranHariIniViewModel
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Presensi Mandiri (Clock In / Out)";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <!-- Header Kartu Jam Real-Time -->
        <div class="card border-0 shadow-sm text-center mb-4 overflow-hidden" style="background: linear-gradient(135deg, #059669 0%, #047857 100%); color: white;">
            <div class="card-body py-4">
                <span class="badge bg-white bg-opacity-25 text-white mb-2 px-3 py-1 fw-semibold text-uppercase font-monospace" style="letter-spacing: 1px;">
                    Presensi Real-Time
                </span>
                <div id="liveClock" class="display-3 fw-bold font-monospace my-1">--:--:--</div>
                <div id="liveDate" class="lead text-white-50">@DateTime.Today.ToString("dddd, dd MMMM yyyy")</div>
            </div>
        </div>

        <!-- Profil Karyawan & Info Shift -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                    <div>
                        <h5 class="fw-bold text-slate-800 mb-0">@Model.NamaKaryawan</h5>
                        <div class="text-muted small">
                            <span class="fw-medium font-monospace">@Model.NomorIndukKaryawan</span> &bull; @Model.NamaDepartemen &bull; @Model.NamaJabatan
                        </div>
                    </div>
                    <span class="badge bg-emerald-light text-emerald px-3 py-2 fw-semibold">
                        <i data-lucide="calendar" style="width: 14px; height: 14px;" class="me-1"></i>
                        @Model.NamaShift
                    </span>
                </div>

                <div class="row g-3 text-center">
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Jam Masuk Shift</div>
                            <div class="fw-bold text-slate-800 font-monospace">@Model.JamMasukShift.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Jam Pulang Shift</div>
                            <div class="fw-bold text-slate-800 font-monospace">@Model.JamPulangShift.ToString(@"hh\:mm")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Toleransi</div>
                            <div class="fw-bold text-slate-800 font-monospace">@Model.ToleransiMenit Menit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Status & Aksi Presensi Hari Ini -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-slate-800 mb-3">Status Presensi Hari Ini (@Model.Tanggal.ToString("dd MMMM yyyy"))</h6>

                <div class="row g-3 mb-4">
                    <!-- Status Check-In -->
                    <div class="col-md-6">
                        <div class="p-3 rounded border @(Model.SudahCheckIn ? "border-success bg-success bg-opacity-10" : "border-dashed bg-light")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold text-slate-700">Check-In</span>
                                @if (Model.SudahCheckIn)
                                {
                                    <span class="badge bg-success text-white">Sudah Masuk</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">Belum Masuk</span>
                                }
                            </div>
                            @if (Model.SudahCheckIn && Model.WaktuMasuk.HasValue)
                            {
                                <div class="h4 fw-bold text-slate-900 font-monospace mb-1">
                                    @Model.WaktuMasuk.Value.ToString("HH:mm:ss")
                                </div>
                                <div class="small text-muted">
                                    @if (Model.MenitKeterlambatan > 0)
                                    {
                                        <span class="text-warning fw-semibold">Terlambat @Model.MenitKeterlambatan menit</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-semibold">Tepat Waktu</span>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.LokasiMasuk))
                                    {
                                        <div><i data-lucide="map-pin" style="width: 12px; height: 12px;"></i> @Model.LokasiMasuk</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Silakan lakukan Check-In di awal jam kerja Anda.</p>
                            }
                        </div>
                    </div>

                    <!-- Status Check-Out -->
                    <div class="col-md-6">
                        <div class="p-3 rounded border @(Model.SudahCheckOut ? "border-primary bg-primary bg-opacity-10" : "border-dashed bg-light")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold text-slate-700">Check-Out</span>
                                @if (Model.SudahCheckOut)
                                {
                                    <span class="badge bg-primary text-white">Sudah Pulang</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white">Belum Pulang</span>
                                }
                            </div>
                            @if (Model.SudahCheckOut && Model.WaktuPulang.HasValue)
                            {
                                <div class="h4 fw-bold text-slate-900 font-monospace mb-1">
                                    @Model.WaktuPulang.Value.ToString("HH:mm:ss")
                                </div>
                                <div class="small text-muted">
                                    <span class="text-primary fw-semibold">Total Jam Kerja: @Model.TotalJamKerja jam</span>
                                    @if (!string.IsNullOrEmpty(Model.LokasiPulang))
                                    {
                                        <div><i data-lucide="map-pin" style="width: 12px; height: 12px;"></i> @Model.LokasiPulang</div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">Check-Out dapat dilakukan setelah Anda selesai bekerja hari ini.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Form Aksi Check-In / Check-Out -->
                @if (Model.BisaCheckIn)
                {
                    <form asp-action="CheckIn" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-slate-700">Catatan Masuk (Opsional)</label>
                            <input type="text" name="CatatanMasuk" class="form-control" placeholder="Contoh: WFO Kantor Pusat / Hadir tepat waktu" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-slate-700">Lokasi Masuk</label>
                            <input type="text" name="LokasiMasuk" class="form-control" value="Kantor Pusat - Jakarta" />
                        </div>
                        <button type="submit" class="btn btn-emerald btn-lg w-100 py-3 fw-bold d-inline-flex justify-content-center align-items-center gap-2 shadow">
                            <i data-lucide="log-in" style="width: 22px; height: 22px;"></i>
                            <span>CHECK-IN SEKARANG</span>
                        </button>
                    </form>
                }
                else if (Model.BisaCheckOut)
                {
                    <form asp-action="CheckOut" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-slate-700">Catatan Pulang (Opsional)</label>
                            <input type="text" name="CatatanPulang" class="form-control" placeholder="Contoh: Selesai tugas sprint / pulang tepat waktu" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-slate-700">Lokasi Pulang</label>
                            <input type="text" name="LokasiPulang" class="form-control" value="Kantor Pusat - Jakarta" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold d-inline-flex justify-content-center align-items-center gap-2 shadow">
                            <i data-lucide="log-out" style="width: 22px; height: 22px;"></i>
                            <span>CHECK-OUT SEKARANG</span>
                        </button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success d-flex align-items-center mb-0" role="alert">
                        <i data-lucide="check-check" style="width: 24px; height: 24px;" class="me-3 text-success"></i>
                        <div>
                            <div class="fw-bold">Presensi Hari Ini Lengkap!</div>
                            <small>Anda telah menyelesaikan Check-In dan Check-Out hari ini dengan total jam kerja <strong>@Model.TotalJamKerja jam</strong>.</small>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="text-center">
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none small">
                <i data-lucide="arrow-left" style="width: 14px; height: 14px;" class="me-1"></i>
                Kembali ke Daftar Kehadiran
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateLiveClock() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const clockEl = document.getElementById('liveClock');
            if (clockEl) {
                clockEl.textContent = `${hours}:${minutes}:${seconds}`;
            }
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();
    </script>
}
