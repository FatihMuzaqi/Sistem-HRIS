@model SistemHRD.ViewModels.AturGajiKaryawanViewModel
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = $"Atur Gaji Karyawan - {Model.NamaKaryawan}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Pengaturan Gaji: @Model.NamaKaryawan</h1>
        <p class="text-muted small mb-0">
            NIK: <strong class="font-monospace text-emerald">@Model.NomorIndukKaryawan</strong> &bull; Departemen: <strong>@Model.NamaDepartemen</strong> &bull; Jabatan: <strong>@Model.NamaJabatan</strong>
        </p>
    </div>
    <a asp-controller="Karyawan" asp-action="Detail" asp-route-id="@Model.KaryawanId" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
        <span>Kembali ke Profil Karyawan</span>
    </a>
</div>

<form asp-action="SimpanGajiKaryawan" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="KaryawanId" value="@Model.KaryawanId" />

    <div class="row g-4">
        <!-- Kolom Kiri: Informasi Pajak & Rekening Perbankan -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold text-slate-800 mb-0">Informasi Pajak & Perbankan</h6>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Status PTKP (Pajak PPh 21) <span class="text-danger">*</span></label>
                        <select name="StatusPTKP" class="form-select">
                            <option value="1" selected="@(Model.StatusPTKP == StatusPTKP.TK0)">TK/0 - Tidak Kawin, 0 Tanggungan (TER A)</option>
                            <option value="2" selected="@(Model.StatusPTKP == StatusPTKP.TK1)">TK/1 - Tidak Kawin, 1 Tanggungan (TER A)</option>
                            <option value="3" selected="@(Model.StatusPTKP == StatusPTKP.TK2)">TK/2 - Tidak Kawin, 2 Tanggungan (TER B)</option>
                            <option value="4" selected="@(Model.StatusPTKP == StatusPTKP.TK3)">TK/3 - Tidak Kawin, 3 Tanggungan (TER B)</option>
                            <option value="5" selected="@(Model.StatusPTKP == StatusPTKP.K0)">K/0 - Kawin, 0 Tanggungan (TER A)</option>
                            <option value="6" selected="@(Model.StatusPTKP == StatusPTKP.K1)">K/1 - Kawin, 1 Tanggungan (TER B)</option>
                            <option value="7" selected="@(Model.StatusPTKP == StatusPTKP.K2)">K/2 - Kawin, 2 Tanggungan (TER B)</option>
                            <option value="8" selected="@(Model.StatusPTKP == StatusPTKP.K3)">K/3 - Kawin, 3 Tanggungan (TER C)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Nama Bank</label>
                        <input name="NamaBank" class="form-control" placeholder="Contoh: BCA / Mandiri / BNI" value="@Model.NamaBank" maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Nomor Rekening</label>
                        <input name="NomorRekeningBank" class="form-control font-monospace" placeholder="1234567890" value="@Model.NomorRekeningBank" maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Nomor NPWP</label>
                        <input name="NomorNPWP" class="form-control font-monospace" placeholder="XX.XXX.XXX.X-XXX.XXX" value="@Model.NomorNPWP" maxlength="50" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">No. BPJS Kesehatan</label>
                        <input name="NomorBpjsKesehatan" class="form-control font-monospace" placeholder="0001234567890" value="@Model.NomorBpjsKesehatan" maxlength="50" />
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-slate-700">No. BPJS Ketenagakerjaan</label>
                        <input name="NomorBpjsKetenagakerjaan" class="form-control font-monospace" placeholder="18012345678" value="@Model.NomorBpjsKetenagakerjaan" maxlength="50" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Kolom Kanan: Rincian Nominal Komponen Gaji -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-slate-800 mb-0">Struktur Komponen Gaji Karyawan</h6>
                    <span class="badge bg-light text-muted border">Komponen Rutin</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-3 py-2">Komponen</th>
                                    <th>Kategori / Sifat</th>
                                    <th style="width: 220px;">Nominal (Rp)</th>
                                    <th class="text-center" style="width: 90px;">Aktif</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y">
                                @for (int i = 0; i < Model.DaftarKomponen.Count; i++)
                                {
                                    var item = Model.DaftarKomponen[i];
                                    <tr>
                                        <td class="ps-3">
                                            <input type="hidden" name="Komponen[@i].KomponenGajiId" value="@item.KomponenGajiId" />
                                            <div class="fw-bold text-slate-800">@item.NamaKomponen</div>
                                            <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.7rem;">@item.KodeKomponen</span>
                                            @if (item.Jenis == JenisKomponenGaji.Pendapatan)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25" style="font-size: 0.7rem;">Pendapatan</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25" style="font-size: 0.7rem;">Potongan</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small fw-semibold text-slate-700">@item.Kategori</div>
                                            <span class="text-muted" style="font-size: 0.75rem;">@item.Sifat</span>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light text-muted">Rp</span>
                                                <input name="Komponen[@i].Nominal" type="number" step="1000" class="form-control font-monospace fw-semibold" value="@((long)item.Nominal)" required />
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="form-check form-switch d-inline-block">
                                                <input name="Komponen[@i].StatusAktif" type="checkbox" class="form-check-input" value="true" @(item.StatusAktif ? "checked" : "") />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
                    <button type="submit" class="btn btn-emerald d-inline-flex align-items-center gap-2">
                        <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                        <span>Simpan Struktur Gaji</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
