@model SistemHRD.ViewModels.DetailPeriodePenggajianViewModel
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = $"Detail Periode {Model.NamaPeriode}";
    var isFinanceOrHrd = User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD) || User.IsInRole(NamaPeran.Finance);
    var isTerkunci = Model.Status == StatusPeriodePenggajian.Disetujui || Model.Status == StatusPeriodePenggajian.Selesai;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h1 class="h3 fw-bold text-slate-800 mb-0">@Model.NamaPeriode</h1>
            @switch (Model.Status)
            {
                case StatusPeriodePenggajian.Draf:
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Draf</span>
                    break;
                case StatusPeriodePenggajian.Diproses:
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Dihitung (Review)</span>
                    break;
                case StatusPeriodePenggajian.MenungguPersetujuan:
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Menunggu Persetujuan</span>
                    break;
                case StatusPeriodePenggajian.Disetujui:
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Disetujui (Terkunci)</span>
                    break;
                case StatusPeriodePenggajian.Selesai:
                    <span class="badge bg-emerald-light text-emerald border border-emerald border-opacity-25 px-2 py-1">Selesai (Dibayar)</span>
                    break;
            }
        </div>
        <p class="text-muted small mb-0">
            Cutoff Absensi: <strong>@Model.TanggalMulai.ToString("dd MMM yyyy") &mdash; @Model.TanggalSelesai.ToString("dd MMM yyyy")</strong> &bull;
            Pembayaran: <strong>@Model.TanggalPembayaran.ToString("dd MMMM yyyy")</strong>
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Kembali</span>
        </a>
        @if (Model.DaftarPenggajian.Any())
        {
            <a asp-action="Ekspor" asp-route-id="@Model.Id" class="btn btn-outline-emerald d-inline-flex align-items-center gap-2">
                <i data-lucide="download" style="width: 16px; height: 16px;"></i>
                <span>Ekspor CSV</span>
            </a>
        }
        @if (isFinanceOrHrd && !isTerkunci)
        {
            <button type="button" class="btn btn-emerald d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalHitungBatch">
                <i data-lucide="calculator" style="width: 16px; height: 16px;"></i>
                <span>Hitung Gaji Batch</span>
            </button>
            @if (Model.DaftarPenggajian.Any())
            {
                <button type="button" class="btn btn-success d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalSetujuiPeriode">
                    <i data-lucide="check-check" style="width: 16px; height: 16px;"></i>
                    <span>Setujui & Terbitkan Slip</span>
                </button>
            }
        }
    </div>
</div>

<!-- Kartu Ringkasan Finansial Periode -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-3">
                <span class="text-muted small fw-medium">Total Karyawan Terhitung</span>
                <div class="h3 fw-bold text-slate-800 mb-0">@Model.TotalKaryawan Orang</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-3">
                <span class="text-muted small fw-medium">Total Gaji Pokok</span>
                <div class="h4 fw-bold text-slate-700 mb-0 font-monospace">Rp @Model.TotalGajiPokok.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body p-3">
                <span class="text-muted small fw-medium">Total Tunjangan & Lembur</span>
                <div class="h4 fw-bold text-slate-700 mb-0 font-monospace">Rp @Model.TotalTunjangan.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light border-start border-4 border-emerald">
            <div class="card-body p-3">
                <span class="text-emerald small fw-semibold">Total Pengeluaran (Take Home Pay)</span>
                <div class="h4 fw-bold text-emerald mb-0 font-monospace">Rp @Model.TotalPengeluaranGaji.ToString("N0")</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabel Daftar Penggajian Karyawan -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold text-slate-800 mb-0">Rincian Payroll Karyawan (@Model.DaftarPenggajian.Count Karyawan)</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">No. Slip</th>
                        <th>Karyawan</th>
                        <th>Departemen / Jabatan</th>
                        <th class="text-end">Gaji Pokok</th>
                        <th class="text-end">Pendapatan Kotor</th>
                        <th class="text-end text-danger">Total Potongan</th>
                        <th class="text-end text-emerald">Gaji Bersih (THP)</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.DaftarPenggajian.Any())
                    {
                        foreach (var item in Model.DaftarPenggajian)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-emerald">
                                    @item.NomorSlipGaji
                                </td>
                                <td>
                                    <div class="fw-bold text-slate-800">@item.NamaKaryawan</div>
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.75rem;">@item.NomorIndukKaryawan</span>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-slate-700">@item.NamaDepartemen</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@item.NamaJabatan</div>
                                </td>
                                <td class="text-end font-monospace">
                                    Rp @item.GajiPokok.ToString("N0")
                                </td>
                                <td class="text-end font-monospace fw-semibold text-slate-800">
                                    Rp @item.TotalPendapatanKotor.ToString("N0")
                                </td>
                                <td class="text-end font-monospace text-danger">
                                    Rp @item.TotalPotongan.ToString("N0")
                                </td>
                                <td class="text-end font-monospace fw-bold text-emerald fs-6">
                                    Rp @item.GajiBersih.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @if (item.ApakahTerkunci)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Disetujui</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Draf Hitung</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Detail" asp-route-id="@item.PenggajianId" class="btn btn-outline-secondary" title="Rincian Komponen">
                                            <i data-lucide="list" style="width: 14px; height: 14px;"></i>
                                        </a>
                                        <a asp-action="Slip" asp-route-id="@item.PenggajianId" class="btn btn-outline-emerald" title="Tampilkan / Cetak Slip">
                                            <i data-lucide="printer" style="width: 14px; height: 14px;"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i data-lucide="calculator" style="width: 48px; height: 48px;" class="mb-3 text-secondary opacity-50"></i>
                                <p class="mb-1 fw-semibold">Belum ada kalkulasi penggajian yang diproses pada periode ini.</p>
                                <p class="small text-muted mb-3">Klik 'Hitung Gaji Batch' untuk memproses kalkulasi gaji otomatis seluruh karyawan.</p>
                                @if (isFinanceOrHrd && !isTerkunci)
                                {
                                    <button type="button" class="btn btn-sm btn-emerald" data-bs-toggle="modal" data-bs-target="#modalHitungBatch">
                                        <i data-lucide="calculator" style="width: 14px; height: 14px;" class="me-1"></i> Hitung Gaji Batch Sekarang
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Hitung Gaji Batch -->
<div class="modal fade" id="modalHitungBatch" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="HitungBatch" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PeriodePenggajianId" value="@Model.Id" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-slate-800">Proses Kalkulasi Gaji Batch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        Sistem akan mengumpulkan data presensi, menghitung keterlambatan, uang lembur, tarif BPJS Kesehatan & Ketenagakerjaan, serta PPh 21 (PP 58/2023) untuk seluruh karyawan aktif.
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Filter Departemen (Opsional)</label>
                        <select name="DepartemenId" asp-items="ViewBag.DaftarDepartemen" class="form-select">
                            <option value="">-- Seluruh Departemen --</option>
                        </select>
                        <small class="text-muted">Kosongkan untuk menghitung gaji seluruh karyawan di perusahaan.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-emerald d-inline-flex align-items-center gap-1">
                        <i data-lucide="play" style="width: 14px; height: 14px;"></i>
                        <span>Mulai Hitung Payroll</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Setujui Periode -->
<div class="modal fade" id="modalSetujuiPeriode" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="SetujuiPeriode" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PeriodePenggajianId" value="@Model.Id" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-success">Persetujuan & Penguncian Payroll</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small mb-3">
                        <i data-lucide="alert-triangle" style="width: 16px; height: 16px;" class="me-1"></i>
                        Setelah disetujui, payroll periode ini akan <strong>terkunci secara permanen</strong> dan slip gaji resmi diterbitkan ke portal masing-masing karyawan.
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Catatan Persetujuan (Opsional)</label>
                        <textarea name="Catatan" class="form-control" rows="2" placeholder="Catatan persetujuan dari pimpinan / direksi..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-success d-inline-flex align-items-center gap-1">
                        <i data-lucide="check" style="width: 14px; height: 14px;"></i>
                        <span>Konfirmasi Setujui Payroll</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
