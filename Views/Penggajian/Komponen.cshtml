@model List<SistemHRD.ViewModels.KomponenGajiViewModel>
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Master Komponen Gaji";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Master Komponen Gaji</h1>
        <p class="text-muted small mb-0">Kelola komponen pendapatan dan potongan yang berlaku pada perusahaan Anda.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
            <span>Kembali ke Payroll</span>
        </a>
        <button type="button" class="btn btn-emerald d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#modalTambahKomponen">
            <i data-lucide="plus-circle" style="width: 18px; height: 18px;"></i>
            <span>Tambah Komponen</span>
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="card-title fw-bold text-slate-800 mb-0">Daftar Komponen Gaji Terdaftar</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">Kode</th>
                        <th>Nama Komponen</th>
                        <th class="text-center">Jenis</th>
                        <th class="text-center">Sifat</th>
                        <th>Kategori</th>
                        <th class="text-center">Pajak</th>
                        <th class="text-center">BPJS</th>
                        <th class="text-center">Otomatis</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 font-monospace fw-bold text-emerald">@item.KodeKomponen</td>
                                <td>
                                    <div class="fw-bold text-slate-800">@item.NamaKomponen</div>
                                    @if (!string.IsNullOrEmpty(item.Keterangan))
                                    {
                                        <small class="text-muted">@item.Keterangan</small>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Jenis == JenisKomponenGaji.Pendapatan)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Pendapatan</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Potongan</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Sifat == SifatKomponenGaji.Tetap)
                                    {
                                        <span class="badge bg-light text-slate-700 border">Tetap</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-warning border">Tidak Tetap</span>
                                    }
                                </td>
                                <td><span class="small fw-semibold text-slate-700">@item.Kategori</span></td>
                                <td class="text-center">
                                    @if (item.KenaPajak)
                                    {
                                        <i data-lucide="check" class="text-success" style="width: 16px; height: 16px;"></i>
                                    }
                                    else
                                    {
                                        <i data-lucide="minus" class="text-muted" style="width: 16px; height: 16px;"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.MasukKalkulasiBpjs)
                                    {
                                        <i data-lucide="check" class="text-success" style="width: 16px; height: 16px;"></i>
                                    }
                                    else
                                    {
                                        <i data-lucide="minus" class="text-muted" style="width: 16px; height: 16px;"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.DihitungOtomatisOlehSistem)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Sistem</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Manual</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.StatusAktif)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Nonaktif</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (!item.DihitungOtomatisOlehSistem)
                                    {
                                        <form asp-action="HapusKomponen" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Hapus komponen ini?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hapus">
                                                <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">Belum ada komponen gaji terdaftar.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Tambah Komponen Gaji -->
<div class="modal fade" id="modalTambahKomponen" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="SimpanKomponen" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold text-slate-800">Tambah Komponen Gaji Baru</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold text-slate-700">Kode Komponen <span class="text-danger">*</span></label>
                            <input name="KodeKomponen" class="form-control text-uppercase" placeholder="Contoh: TJ-KOM" required maxlength="50" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold text-slate-700">Nama Komponen <span class="text-danger">*</span></label>
                            <input name="NamaKomponen" class="form-control" placeholder="Contoh: Tunjangan Komunikasi" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-slate-700">Jenis Komponen <span class="text-danger">*</span></label>
                            <select name="Jenis" class="form-select">
                                <option value="1">Pendapatan (Penambah)</option>
                                <option value="2">Potongan (Pengurang)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-slate-700">Sifat Komponen <span class="text-danger">*</span></label>
                            <select name="Sifat" class="form-select">
                                <option value="1">Tetap (Fixed bulanan)</option>
                                <option value="2">Tidak Tetap (Variabel)</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-slate-700">Kategori</label>
                            <select name="Kategori" class="form-select">
                                <option value="2">Tunjangan Tetap</option>
                                <option value="3">Tunjangan Tidak Tetap</option>
                                <option value="5">Bonus / Insentif</option>
                                <option value="40">Kasbon / Pinjaman</option>
                                <option value="41">Iuran Koperasi</option>
                                <option value="99">Potongan Lainnya</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-slate-700">Nilai Bawaan (Default)</label>
                            <input name="NilaiBawaan" type="number" step="1000" class="form-control" value="0" />
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-check me-3">
                                <input name="KenaPajak" type="checkbox" class="form-check-input" id="checkKenaPajak" value="true" checked />
                                <label class="form-check-label small" for="checkKenaPajak">Kena PPh 21</label>
                            </div>
                            <div class="form-check">
                                <input name="MasukKalkulasiBpjs" type="checkbox" class="form-check-input" id="checkBpjs" value="true" checked />
                                <label class="form-check-label small" for="checkBpjs">Basis BPJS</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-slate-700">Keterangan (Opsional)</label>
                            <textarea name="Keterangan" class="form-control" rows="2" placeholder="Penjelasan mengenai komponen ini..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-emerald d-inline-flex align-items-center gap-1">
                        <i data-lucide="save" style="width: 14px; height: 14px;"></i>
                        <span>Simpan Komponen</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
