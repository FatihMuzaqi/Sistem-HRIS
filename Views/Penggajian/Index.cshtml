@model List<SistemHRD.ViewModels.PeriodePenggajianItemViewModel>
@using SistemHRD.Common.Constants
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Manajemen Penggajian (Payroll)";
    var isFinanceOrHrd = User.IsInRole(NamaPeran.SuperAdmin) || User.IsInRole(NamaPeran.HRD) || User.IsInRole(NamaPeran.Finance);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Manajemen Penggajian (Payroll)</h1>
        <p class="text-muted small mb-0">Kelola siklus penggajian bulanan, perhitungan otomatis BPJS & PPh 21, approval, dan penerbitan slip gaji.</p>
    </div>
    @if (isFinanceOrHrd)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="TambahPeriode" class="btn btn-emerald d-inline-flex align-items-center gap-2">
                <i data-lucide="calendar-plus" style="width: 18px; height: 18px;"></i>
                <span>Buat Periode Baru</span>
            </a>
            <a asp-action="Komponen" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i data-lucide="layers" style="width: 18px; height: 18px;"></i>
                <span>Master Komponen</span>
            </a>
            <a asp-action="Kebijakan" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i data-lucide="settings" style="width: 18px; height: 18px;"></i>
                <span>Kebijakan Tarif</span>
            </a>
        </div>
    }
</div>

<!-- Kartu Ringkasan Metrik Penggajian -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card border-start border-4 border-emerald shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Total Periode</span>
                <div class="stat-icon bg-emerald-light text-emerald rounded p-1">
                    <i data-lucide="calendar" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">@Model.Count</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card border-start border-4 border-warning shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Periode Aktif / Draf</span>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded p-1">
                    <i data-lucide="clock" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">
                @Model.Count(p => p.Status == StatusPeriodePenggajian.Draf || p.Status == StatusPeriodePenggajian.Diproses || p.Status == StatusPeriodePenggajian.MenungguPersetujuan)
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card border-start border-4 border-success shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Disetujui / Selesai</span>
                <div class="stat-icon bg-success bg-opacity-10 text-success rounded p-1">
                    <i data-lucide="check-circle" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h3 fw-bold text-slate-800 mb-0">
                @Model.Count(p => p.Status == StatusPeriodePenggajian.Disetujui || p.Status == StatusPeriodePenggajian.Selesai)
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card border-start border-4 border-info shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted small fw-medium">Total Akumulasi Gaji</span>
                <div class="stat-icon bg-info bg-opacity-10 text-info rounded p-1">
                    <i data-lucide="dollar-sign" style="width: 18px; height: 18px;"></i>
                </div>
            </div>
            <div class="h5 fw-bold text-slate-800 mb-0 font-monospace">
                Rp @Model.Sum(p => p.TotalPengeluaranGaji).ToString("N0")
            </div>
        </div>
    </div>
</div>

<!-- Tabel Daftar Periode Penggajian -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold text-slate-800 mb-0">Daftar Siklus Periode Penggajian</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3">Nama Periode</th>
                        <th>Bulan / Tahun</th>
                        <th>Rentang Cutoff</th>
                        <th>Tanggal Bayar</th>
                        <th class="text-center">Karyawan</th>
                        <th class="text-end">Total Pengeluaran</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a asp-action="PeriodeDetail" asp-route-id="@item.Id" class="fw-bold text-emerald text-decoration-none">
                                        @item.NamaPeriode
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.Catatan))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 200px;">@item.Catatan</div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold text-slate-800">
                                        @System.Globalization.CultureInfo.GetCultureInfo("id-ID").DateTimeFormat.GetMonthName(item.Bulan) @item.Tahun
                                    </span>
                                </td>
                                <td class="small text-slate-600">
                                    @item.TanggalMulai.ToString("dd MMM yyyy") &mdash; @item.TanggalSelesai.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge bg-light text-slate-700 border font-monospace">
                                        @item.TanggalPembayaran.ToString("dd MMMM yyyy")
                                    </span>
                                </td>
                                <td class="text-center fw-bold">
                                    <span class="badge bg-light text-emerald border font-monospace px-2 py-1">
                                        @item.TotalKaryawan Orang
                                    </span>
                                </td>
                                <td class="text-end font-monospace fw-bold text-slate-800">
                                    Rp @item.TotalPengeluaranGaji.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @switch (item.Status)
                                    {
                                        case StatusPeriodePenggajian.Draf:
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Draf</span>
                                            break;
                                        case StatusPeriodePenggajian.Diproses:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Dihitung (Review)</span>
                                            break;
                                        case StatusPeriodePenggajian.MenungguPersetujuan:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Menunggu Persetujuan</span>
                                            break;
                                        case StatusPeriodePenggajian.Disetujui:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Disetujui (Terkunci)</span>
                                            break;
                                        case StatusPeriodePenggajian.Selesai:
                                            <span class="badge bg-emerald-light text-emerald border border-emerald border-opacity-25 px-2 py-1">Selesai (Dibayar)</span>
                                            break;
                                        case StatusPeriodePenggajian.Dibatalkan:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border px-2 py-1">Dibatalkan</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="PeriodeDetail" asp-route-id="@item.Id" class="btn btn-outline-emerald" title="Detail Payroll">
                                            <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                                        </a>
                                        @if (isFinanceOrHrd && item.Status != StatusPeriodePenggajian.Disetujui && item.Status != StatusPeriodePenggajian.Selesai)
                                        {
                                            <form asp-action="HapusPeriode" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus periode penggajian ini?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Hapus Periode">
                                                    <i data-lucide="trash-2" style="width: 14px; height: 14px;"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i data-lucide="calendar-x" style="width: 48px; height: 48px;" class="mb-3 text-secondary opacity-50"></i>
                                <p class="mb-1 fw-semibold">Belum ada periode penggajian yang dibuat.</p>
                                <p class="small text-muted mb-3">Mulai buat periode penggajian bulanan untuk mengkalkulasi payroll karyawan.</p>
                                @if (isFinanceOrHrd)
                                {
                                    <a asp-action="TambahPeriode" class="btn btn-sm btn-emerald">
                                        <i data-lucide="plus" style="width: 14px; height: 14px;" class="me-1"></i> Buat Periode Baru
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
