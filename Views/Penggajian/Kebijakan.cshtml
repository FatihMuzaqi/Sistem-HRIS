@model SistemHRD.ViewModels.KebijakanPenggajianViewModel
@using SistemHRD.Models.Enums

@{
    ViewData["Title"] = "Kebijakan Tarif & Aturan Penggajian";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <div>
        <h1 class="h3 fw-bold text-slate-800 mb-1">Kebijakan Tarif & Aturan Penggajian</h1>
        <p class="text-muted small mb-0">Konfigurasikan persentase BPJS Kesehatan, BPJS Ketenagakerjaan, PPh 21, dan aturan absensi perusahaan.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i data-lucide="arrow-left" style="width: 16px; height: 16px;"></i>
        <span>Kembali ke Payroll</span>
    </a>
</div>

<form asp-action="SimpanKebijakan" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">
        <!-- 1. Kebijakan Lembur & Keterlambatan -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold text-slate-800 mb-0">1. Aturan Lembur & Denda Keterlambatan</h6>
                </div>
                <div class="card-body p-3">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="HitungLemburOtomatis" class="form-check-input" type="checkbox" id="switchLembur" />
                        <label class="form-check-label fw-semibold small" for="switchLembur">Hitung Uang Lembur Otomatis dari Presensi</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Tarif Lembur per Jam Flat (Rp)</label>
                        <input asp-for="TarifLemburPerJamFlat" type="number" step="1000" class="form-control font-monospace" />
                        <small class="text-muted">Isi 0 untuk menggunakan formula baku Kemnaker: <code>1/173 x (Gaji Pokok + Tunjangan Tetap)</code>.</small>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="form-check form-switch mb-3">
                        <input asp-for="TerapkanPotonganKeterlambatan" class="form-check-input" type="checkbox" id="switchTelat" />
                        <label class="form-check-label fw-semibold small" for="switchTelat">Terapkan Denda Potongan Keterlambatan Presensi</label>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700">Toleransi Gratis (Menit)</label>
                            <input asp-for="ToleransiKeterlambatanGratisMenit" type="number" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-slate-700">Denda / Menit (Rp)</label>
                            <input asp-for="DendaKeterlambatanPerMenit" type="number" step="100" class="form-control font-monospace" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Siklus Periode & Cutoff -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold text-slate-800 mb-0">2. Siklus Tanggal Cutoff Bulanan</h6>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="form-label small fw-semibold text-slate-700">Cutoff Awal</label>
                            <input asp-for="TanggalCutoffAwal" type="number" min="1" max="31" class="form-control text-center font-monospace" />
                            <small class="text-muted d-block text-center">Bulan lalu (tgl)</small>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold text-slate-700">Cutoff Akhir</label>
                            <input asp-for="TanggalCutoffAkhir" type="number" min="1" max="31" class="form-control text-center font-monospace" />
                            <small class="text-muted d-block text-center">Bulan ini (tgl)</small>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold text-slate-700">Hari Gajian</label>
                            <input asp-for="TanggalPembayaranGaji" type="number" min="1" max="31" class="form-control text-center font-monospace text-emerald fw-bold" />
                            <small class="text-muted d-block text-center">Transfer (tgl)</small>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-slate-700">Catatan Kaki Default pada Slip Gaji</label>
                        <textarea asp-for="CatatanSlipGajiDefault" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Kebijakan BPJS Kesehatan & BPJS Ketenagakerjaan -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold text-slate-800 mb-0">3. Aturan Tarif BPJS</h6>
                </div>
                <div class="card-body p-3">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="TerapkanBpjsKesehatan" class="form-check-input" type="checkbox" id="switchBpjsKes" />
                        <label class="form-check-label fw-semibold small" for="switchBpjsKes">Terapkan BPJS Kesehatan</label>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label class="form-label small text-muted">Pekerja (%)</label>
                            <input asp-for="PersenBpjsKesehatanPekerja" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Pemberi Kerja (%)</label>
                            <input asp-for="PersenBpjsKesehatanPerusahaan" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Batas Upah Maks (Rp)</label>
                            <input asp-for="BatasMaksimalUpahBpjsKesehatan" type="number" class="form-control form-control-sm font-monospace" />
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="form-check form-switch mb-2">
                        <input asp-for="TerapkanBpjsKetenagakerjaan" class="form-check-input" type="checkbox" id="switchBpjsTk" />
                        <label class="form-check-label fw-semibold small" for="switchBpjsTk">Terapkan BPJS Ketenagakerjaan</label>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small text-muted">JHT Pekerja (%)</label>
                            <input asp-for="PersenBpjsJhtPekerja" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">JHT Perusahaan (%)</label>
                            <input asp-for="PersenBpjsJhtPerusahaan" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-4">
                            <label class="form-label small text-muted">JP Pekerja (%)</label>
                            <input asp-for="PersenBpjsJpPekerja" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">JP Perusahaan (%)</label>
                            <input asp-for="PersenBpjsJpPerusahaan" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small text-muted">Batas Upah JP (Rp)</label>
                            <input asp-for="BatasMaksimalUpahBpjsJp" type="number" class="form-control form-control-sm font-monospace" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small text-muted">JKK Perusahaan (%)</label>
                            <input asp-for="PersenBpjsJkkPerusahaan" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small text-muted">JKM Perusahaan (%)</label>
                            <input asp-for="PersenBpjsJkmPerusahaan" type="number" step="0.01" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Kebijakan Pajak PPh 21 -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold text-slate-800 mb-0">4. Aturan Pajak Penghasilan (PPh 21)</h6>
                </div>
                <div class="card-body p-3">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="TerapkanPph21" class="form-check-input" type="checkbox" id="switchPph" />
                        <label class="form-check-label fw-semibold small" for="switchPph">Hitung Potongan PPh 21 Karyawan</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-700">Metode Perhitungan Pajak Default</label>
                        <select asp-for="MetodePph21" class="form-select">
                            <option value="1">TER PP 58/2023 (Tarif Efektif Rata-Rata Bulanan)</option>
                            <option value="2">Pasal 17 UU HPP (Tarif Progresif)</option>
                            <option value="4">Nett (Pajak Ditanggung Perusahaan Penuh / Bebas Pajak)</option>
                        </select>
                    </div>

                    <div class="alert alert-info small mb-0">
                        <i data-lucide="info" style="width: 16px; height: 16px;" class="me-1"></i>
                        Sistem mengimplementasikan tabel resmi <strong>PP No. 58 Tahun 2023</strong> kategori TER A, TER B, dan TER C yang terintegrasi otomatis berdasarkan status PTKP masing-masing karyawan.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Batal</a>
            <button type="submit" class="btn btn-emerald d-inline-flex align-items-center gap-2">
                <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                <span>Simpan Kebijakan Penggajian</span>
            </button>
        </div>
    </div>
</form>
